package {{package}};

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Calendar;
import java.util.Comparator;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;
import java.util.regex.Pattern;

import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ValueMap;

/**
 * Computes a content-based fingerprint for a library component so structurally identical
 * components can be grouped as duplicates regardless of which brand folder they live in.
 *
 * The fingerprint deliberately excludes catalog-curation metadata (title, description, owner,
 * status, version, sub-category, tags, timestamps) since those legitimately differ between two
 * functionally identical components without making them "not duplicates". Everything else that
 * affects rendering or authoring behaviour — resourceSuperType, any other component property,
 * dialog field set, edit config, and local HTL markup — is included, so two components only
 * match when they are behaviourally indistinguishable. This is intentionally a precision-first
 * (zero false positives), not a recall-first (catch every near-duplicate), signal.
 *
 * Generated by AEM Component Catalog.
 */
final class ComponentFingerprint {

    private static final Set<String> METADATA_PROPERTIES = new HashSet<>(Arrays.asList(
            "jcr:title", "jcr:description", "jcr:created", "jcr:createdBy",
            "jcr:lastModified", "jcr:lastModifiedBy", "cq:lastModified", "cq:lastModifiedBy",
            "jcr:primaryType", "jcr:mixinTypes", "jcr:uuid",
            "catalogOwner", "catalogStatus", "catalogVersion", "catalogSubCategory", "catalogTags",
            // Cosmetic-only dialog-field attributes (label/help copy) that don't change authoring
            // behaviour or the stored content shape, so a wording tweak alone shouldn't break a match.
            "fieldLabel", "fieldDescription", "emptyText", "helpPath", "trackingFeature"));

    private static final Set<String> NON_RENDER_CHILD_NAMES = new HashSet<>(Arrays.asList(
            "_cq_dialog", "cq:dialog", "_cq_editconfig", "cq:editconfig",
            "_cq_design_dialog", "cq:design_dialog", "_cq_template", "cq:template",
            "layouts", "readme.md"));

    private static final Set<String> FOLDER_TYPES = new HashSet<>(Arrays.asList(
            "nt:folder", "sling:folder", "sling:orderedfolder", "cq:clientlibraryfolder"));

    private static final Set<String> CONTENT_EXTENSIONS = new HashSet<>(Arrays.asList(
            ".html", ".less", ".css", ".js", ".txt"));

    private static final Pattern HTL_COMMENT = Pattern.compile("<!--/\\*.*?\\*/-->", Pattern.DOTALL);
    private static final Pattern WHITESPACE = Pattern.compile("\\s+");

    private ComponentFingerprint() {
    }

    static String compute(Resource component) {
        try {
            StringBuilder sb = new StringBuilder();
            appendProperties(sb, component.getValueMap());
            sb.append("|DIALOG|");
            appendResourceTree(sb, findChild(component, "_cq_dialog", "cq:dialog"));
            sb.append("|EDITCONFIG|");
            appendResourceTree(sb, findChild(component, "_cq_editConfig", "cq:editConfig"));
            sb.append("|TEMPLATE|");
            appendResourceTree(sb, findChild(component, "_cq_template", "cq:template"));
            sb.append("|CONTENT|");
            appendContentFiles(sb, component);
            return sha256(sb.toString());
        } catch (RuntimeException e) {
            // A component that fails to fingerprint must never accidentally collide with another
            // component's real fingerprint, so fall back to something guaranteed unique to it.
            return "unfingerprinted:" + component.getPath();
        }
    }

    private static void appendProperties(StringBuilder sb, ValueMap properties) {
        TreeMap<String, Object> sorted = new TreeMap<>();
        for (String key : properties.keySet()) {
            if (METADATA_PROPERTIES.contains(key)) {
                continue;
            }
            Object value = properties.get(key);
            if (value instanceof Calendar) {
                continue;
            }
            sorted.put(key, value);
        }
        for (Map.Entry<String, Object> entry : sorted.entrySet()) {
            sb.append(entry.getKey()).append('=').append(stringifyValue(entry.getValue())).append(';');
        }
    }

    private static String stringifyValue(Object value) {
        if (value instanceof Object[]) {
            Object[] arr = (Object[]) value;
            String[] parts = new String[arr.length];
            for (int i = 0; i < arr.length; i++) {
                parts[i] = String.valueOf(arr[i]);
            }
            Arrays.sort(parts);
            return String.join(",", parts);
        }
        return String.valueOf(value);
    }

    private static void appendResourceTree(StringBuilder sb, Resource resource) {
        if (resource == null) {
            sb.append("(none)");
            return;
        }
        appendProperties(sb, resource.getValueMap());
        List<Resource> children = new ArrayList<>();
        for (Resource child : resource.getChildren()) {
            children.add(child);
        }
        children.sort(Comparator.comparing(Resource::getName));
        for (Resource child : children) {
            sb.append('[').append(child.getName()).append(':');
            appendResourceTree(sb, child);
            sb.append(']');
        }
    }

    /**
     * Appends every local HTL script and clientlib source file (CSS/LESS/JS, plus the css.txt/
     * js.txt manifests that control their include order) under the component — this is what
     * actually renders and styles the component, as opposed to {@code _cq_dialog}/
     * {@code _cq_editConfig}/{@code _cq_template}, which describe the authoring experience and
     * are hashed separately.
     */
    private static void appendContentFiles(StringBuilder sb, Resource component) {
        List<Resource> files = new ArrayList<>();
        collectContentFiles(component, files);
        files.sort(Comparator.comparing(Resource::getPath));
        for (Resource file : files) {
            String content = readAsString(file);
            if (content == null) {
                continue;
            }
            sb.append(file.getName()).append('=').append(normalizeText(content)).append(';');
        }
    }

    private static void collectContentFiles(Resource parent, List<Resource> out) {
        for (Resource child : parent.getChildren()) {
            String lower = child.getName().toLowerCase();
            if (NON_RENDER_CHILD_NAMES.contains(lower)) {
                continue;
            }
            if (hasContentExtension(lower)) {
                out.add(child);
                continue;
            }
            String primaryType = child.getValueMap().get("jcr:primaryType", "");
            if (FOLDER_TYPES.contains(primaryType.toLowerCase())) {
                collectContentFiles(child, out);
            }
        }
    }

    private static boolean hasContentExtension(String lowerName) {
        for (String ext : CONTENT_EXTENSIONS) {
            if (lowerName.endsWith(ext)) {
                return true;
            }
        }
        return false;
    }

    private static String readAsString(Resource file) {
        InputStream is = file.adaptTo(InputStream.class);
        if (is == null) {
            Resource content = file.getChild("jcr:content");
            is = content != null ? content.adaptTo(InputStream.class) : null;
        }
        if (is == null) {
            return null;
        }
        try (InputStream stream = is) {
            ByteArrayOutputStream buffer = new ByteArrayOutputStream();
            byte[] chunk = new byte[4096];
            int read;
            while ((read = stream.read(chunk)) != -1) {
                buffer.write(chunk, 0, read);
            }
            return buffer.toString(StandardCharsets.UTF_8.name());
        } catch (IOException e) {
            return null;
        }
    }

    private static String normalizeText(String content) {
        String noComments = HTL_COMMENT.matcher(content).replaceAll(" ");
        return WHITESPACE.matcher(noComments).replaceAll(" ").trim();
    }

    private static Resource findChild(Resource parent, String... names) {
        for (String name : names) {
            Resource child = parent.getChild(name);
            if (child != null) {
                return child;
            }
        }
        return null;
    }

    private static String sha256(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] hash = digest.digest(input.getBytes(StandardCharsets.UTF_8));
            StringBuilder hex = new StringBuilder(hash.length * 2);
            for (byte b : hash) {
                String hexPart = Integer.toHexString(0xff & b);
                if (hexPart.length() == 1) {
                    hex.append('0');
                }
                hex.append(hexPart);
            }
            return hex.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new IllegalStateException("SHA-256 not available", e);
        }
    }
}

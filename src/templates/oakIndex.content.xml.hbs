<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lucene index backing the component-usage crawl's
    "sling:resourceType LIKE '%/components/%'" query (leading AND trailing wildcard,
    scoped to /content). Without it Oak falls back to a full unindexed repository
    traversal on every rebuild.

    Ships in ui.apps (the CODE package), not ui.content: AEMaaCS requires /oak:index
    definitions to be deployed as code so Cloud Manager can install and reindex them
    before the blue-green switchover, ahead of any mutable content package.

    The node name must stay AEMaaCS-compliant: <prefix>.<indexName>-custom-<version>.
    Never edit this definition in place on a deployed environment — add a new node with
    an incremented -custom-<version> instead.

    Generated by AEM Component Catalog.
-->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:oak="http://jackrabbit.apache.org/oak/ns/1.0"
    jcr:primaryType="oak:QueryIndexDefinition"
    type="lucene"
    async="[async]"
    compatVersion="{Long}2"
    evaluatePathRestrictions="{Boolean}true"
    includedPaths="[/content]"
    reindex="{Boolean}false">
    <indexRules jcr:primaryType="nt:unstructured">
        <nt:base jcr:primaryType="nt:unstructured">
            <properties jcr:primaryType="nt:unstructured">
                <slingResourceType
                    jcr:primaryType="nt:unstructured"
                    name="sling:resourceType"
                    propertyIndex="{Boolean}true"
                    analyzed="{Boolean}true"/>
            </properties>
        </nt:base>
    </indexRules>
</jcr:root>

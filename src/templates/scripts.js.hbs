/* ============================================================
   {{appId}} — Component Library (auto-discovery)
   Fetches servlet JSON, renders listing grid with group filters,
   and renders detail view via URL suffix.

   Generated by AEM Component Library Generator.
   ============================================================ */
(function () {
    "use strict";

    /* Full catalog dataset, shared between listing, facets, and detail relationships. */
    var catalogData = null;

    /* ------ helpers ------ */
    function esc(s) { var d = document.createElement("div"); d.textContent = String(s == null ? "" : s); return d.innerHTML; }

    function groupSlug(g) {
        return g.replace(/^{{replace appId "-" "[-\\\\s]"}}\\s*[-\\u2013\\u2014]\\s*/i, "").trim().toLowerCase().replace(/[^a-z0-9_-]+/g, "-");
    }

    function groupLabel(g) {
        return g.replace(/^{{replace appId "-" "[-\\\\s]"}}\\s*[-\\u2013\\u2014]\\s*/i, "").trim();
    }

    function badgeClass(g) {
        var slug = groupSlug(g);
        return "pcl-card__badge--" + slug;
    }

    function getSuffix() {
        var path = window.location.pathname;
        var idx = path.indexOf(".html/");
        if (idx === -1) return null;
        var suffix = path.substring(idx + 6);
        return suffix ? decodeURIComponent(suffix) : null;
    }

    function getPagePath() {
        var lib = document.querySelector(".pcl-library[data-page-path]");
        return lib ? lib.getAttribute("data-page-path") : "";
    }

    {{#if features.readme}}
    /* ------ Markdown to HTML ------ */
    function md2html(md) {
        var h = esc(md);
        h = h.replace(/```(\w*)\n([\s\S]*?)```/g, function (_, lang, code) {
            return '<pre><code class="language-' + lang + '">' + code.trim() + "</code></pre>";
        });
        h = h.replace(/`([^`]+)`/g, "<code>$1</code>");
        h = h.replace(/^#### (.+)$/gm, "<h4>$1</h4>");
        h = h.replace(/^### (.+)$/gm, "<h3>$1</h3>");
        h = h.replace(/^## (.+)$/gm, "<h2>$1</h2>");
        h = h.replace(/^# (.+)$/gm, "<h1>$1</h1>");
        h = h.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
        h = h.replace(/\*([^*]+)\*/g, "<em>$1</em>");
        h = h.replace(/^> (.+)$/gm, "<blockquote>$1</blockquote>");
        h = h.replace(/^---$/gm, "<hr/>");
        h = h.replace(/^\|(.+)\|$/gm, function (line) {
            if (/^\|[\s\-:|]+\|$/.test(line)) return "<!--sep-->";
            var cells = line.split("|").filter(function (c) { return c.trim() !== ""; });
            return "<tr>" + cells.map(function (c) { return "<td>" + c.trim() + "</td>"; }).join("") + "</tr>";
        });
        h = h.replace(/((<tr>.*<\/tr>\n?)+)/g, function (rows) {
            var first = rows.indexOf("</tr>");
            var head = rows.substring(0, first + 5).replace(/<td>/g, "<th>").replace(/<\/td>/g, "</th>");
            var body = rows.substring(first + 5).replace(/<!--sep-->\n?/g, "");
            return "<table><thead>" + head + "</thead><tbody>" + body + "</tbody></table>";
        });
        h = h.replace(/^- (.+)$/gm, "<li>$1</li>");
        h = h.replace(/(<li>.*<\/li>\n?)+/g, function (m) { return "<ul>" + m + "</ul>"; });
        h = h.replace(/^(?!<[a-z/!])((?!^\s*$).+)$/gm, "<p>$1</p>");
        h = h.replace(/\n{3,}/g, "\n\n");
        return h;
    }
    {{/if}}

    /* ====================================================
       LISTING VIEW
       ==================================================== */
    function subLabel(sub) {
        // Curated sub-categories are already friendly; group values get the appId prefix stripped.
        return groupLabel(String(sub == null ? "" : sub));
    }

    function renderCard(comp, pagePath, category, sub) {
        var href = pagePath + ".html/" + encodeURIComponent(comp.name);
        var hasThumbnail = !!comp.thumbnailPath;
        var html = '<a class="pcl-card" href="' + href + '" data-title="' + esc(comp.title) + '" data-desc="' + esc(comp.description) + '" data-group="' + esc(comp.group) + '" data-category="' + esc(category) + '" data-subcategory="' + esc(sub) + '" data-owner="' + esc(comp.owner) + '" data-status="' + esc(comp.status) + '" data-quality="' + esc(comp.qualityScore == null ? "" : comp.qualityScore) + '">';
        html += '<div class="pcl-card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>';
        if (hasThumbnail) {
            html += '<div class="pcl-card__preview pcl-card__preview--has-thumb"><img class="pcl-card__thumb" src="' + esc(comp.thumbnailPath) + '" alt="' + esc(comp.title) + '" loading="lazy"/></div>';
        } else {
            html += '<div class="pcl-card__preview"><div class="pcl-card__preview-pattern"></div><div class="pcl-card__preview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div></div>';
        }
        html += '<div class="pcl-card__body">';
        html += '<div class="pcl-card__header"><h3 class="pcl-card__title">' + esc(comp.title) + '</h3><span class="pcl-card__badge ' + badgeClass(comp.group) + '">' + esc(subLabel(sub)) + "</span></div>";
        html += '<p class="pcl-card__desc">' + (comp.description ? esc(comp.description) : "Component \u2014 click for details and documentation.") + "</p>";
        html += '<div class="pcl-card__meta">';
        html += '<span class="pcl-card__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>' + esc(category) + " \u203a " + esc(subLabel(sub)) + "</span>";
        var uc = comp.usageCount || 0;
        html += '<span class="pcl-card__meta-item pcl-usage' + (uc > 0 ? "" : " pcl-usage--none") + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' + (uc > 0 ? (uc + (uc === 1 ? " page" : " pages")) : "Unused") + "</span>";
        if (comp.layouts && comp.layouts.length > 0) {
            html += '<span class="pcl-card__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>' + comp.layouts.length + ' example' + (comp.layouts.length > 1 ? 's' : '') + '</span>';
        }
        html += "</div></div></a>";
        return html;
    }

    function renderListing(data) {
        var pagePath = getPagePath();
        var main = document.getElementById("pcl-main");
        var toolbar = document.getElementById("pcl-toolbar");
        var pillsContainer = document.getElementById("pcl-filter-pills");
        var categories = data.categories || {};

        var totalEl = document.getElementById("pcl-total-count");
        var catEl = document.getElementById("pcl-category-count");
        if (totalEl) totalEl.textContent = data.total;
        if (catEl) catEl.textContent = Object.keys(categories).length;

        toolbar.style.display = "";
        // Top-level filter pills = Category (website).
        var pillsHtml = '<button class="pcl-filter-pill active" data-filter="">All <span class="pcl-filter-pill__count">' + data.total + "</span></button>";
        var catNames = Object.keys(categories).sort();
        for (var ci = 0; ci < catNames.length; ci++) {
            var cn = catNames[ci];
            pillsHtml += '<button class="pcl-filter-pill" data-filter="' + esc(cn) + '">' +
                esc(cn) + ' <span class="pcl-filter-pill__count">' + categories[cn] + "</span></button>";
        }
        pillsContainer.innerHTML = pillsHtml;

        {{#if features.qualityScore}}
        renderFacets(data.components);
        renderMetrics(data);
        {{/if}}

        // Group components: Category (website) -> Sub Category -> [components].
        var byCategory = {};
        var components = data.components;
        for (var i = 0; i < components.length; i++) {
            var c = components[i];
            var cat = c.category || "General";
            var sub = c.subCategory || c.group || "Other";
            if (!byCategory[cat]) byCategory[cat] = {};
            if (!byCategory[cat][sub]) byCategory[cat][sub] = [];
            byCategory[cat][sub].push(c);
        }

        var html = "";
        var sortedCats = Object.keys(byCategory).sort();
        for (var ck = 0; ck < sortedCats.length; ck++) {
            var category = sortedCats[ck];
            var subs = byCategory[category];
            var catTotal = 0;
            var sortedSubs = Object.keys(subs).sort();
            for (var s0 = 0; s0 < sortedSubs.length; s0++) catTotal += subs[sortedSubs[s0]].length;
            html += '<section class="pcl-category-section" data-category="' + esc(category) + '">';
            html += '<h2 class="pcl-section-title">' + esc(category) + ' <span class="pcl-section-title__count">' + catTotal + '</span></h2>';
            for (var sk = 0; sk < sortedSubs.length; sk++) {
                var sub = sortedSubs[sk];
                var list = subs[sub];
                html += '<div class="pcl-subcategory-section" data-subcategory="' + esc(sub) + '">';
                html += '<h3 class="pcl-subcategory-title">' + esc(subLabel(sub)) + ' <span class="pcl-subcategory-title__count">' + list.length + '</span></h3>';
                html += '<div class="pcl-grid">';
                for (var j = 0; j < list.length; j++) {
                    html += renderCard(list[j], pagePath, category, sub);
                }
                html += "</div></div>";
            }
            html += "</section>";
        }

        html += '<div class="pcl-empty" style="display:none;"><svg class="pcl-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg><h3 class="pcl-empty__title">No components found</h3><p class="pcl-empty__desc">Try adjusting your search or filter criteria.</p></div>';
        main.innerHTML = html;

        var searchInput = document.querySelector(".pcl-search__input");
        if (searchInput) {
            searchInput.addEventListener("input", function () {
                applyFilters(searchInput.value, getActiveFilter(), getFacetState());
            });
        }
        bindPills(searchInput);
        bindFacets(searchInput);
    }

    /* ------ facets (Status / Owner / Quality) ------ */
    function uniqueValues(components, key) {
        var seen = {};
        var out = [];
        for (var i = 0; i < components.length; i++) {
            var v = (components[i][key] || "").trim();
            if (v && !seen[v]) { seen[v] = true; out.push(v); }
        }
        return out.sort();
    }

    function selectFacet(id, label, values) {
        var html = '<label class="pcl-facet"><span class="pcl-facet__label">' + esc(label) + '</span>';
        html += '<select class="pcl-facet__select" id="' + id + '"><option value="">All</option>';
        for (var i = 0; i < values.length; i++) {
            html += '<option value="' + esc(values[i]) + '">' + esc(values[i]) + "</option>";
        }
        return html + "</select></label>";
    }

    function renderFacets(components) {
        var container = document.getElementById("pcl-facets");
        if (!container) return;
        var html = selectFacet("pcl-facet-status", "Status", uniqueValues(components, "status"));
        html += selectFacet("pcl-facet-owner", "Owner", uniqueValues(components, "owner"));
        {{#if features.qualityScore}}
        html += '<label class="pcl-facet"><span class="pcl-facet__label">Quality</span>' +
            '<select class="pcl-facet__select" id="pcl-facet-quality">' +
            '<option value="">Any</option><option value="high">Ready (≥70)</option><option value="low">Needs work (&lt;70)</option>' +
            "</select></label>";
        {{/if}}
        html += '<button type="button" class="pcl-facet__reset" id="pcl-facet-reset">Reset</button>';
        container.innerHTML = html;
    }

    function getFacetState() {
        function val(id) { var el = document.getElementById(id); return el ? el.value : ""; }
        return { status: val("pcl-facet-status"), owner: val("pcl-facet-owner"), quality: val("pcl-facet-quality") };
    }

    function bindFacets(searchInput) {
        var container = document.getElementById("pcl-facets");
        if (!container) return;
        container.addEventListener("change", function () {
            applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
        });
        var reset = document.getElementById("pcl-facet-reset");
        if (reset) {
            reset.addEventListener("click", function () {
                ["pcl-facet-status", "pcl-facet-owner", "pcl-facet-quality"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = "";
                });
                applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
            });
        }
    }

    {{#if features.qualityScore}}
    /* ------ quality dashboard strip ------ */
    function renderMetrics(data) {
        var container = document.getElementById("pcl-metrics");
        if (!container) return;
        var comps = data.components || [];
        var total = comps.length || 1;
        var sumQuality = 0, documented = 0, governed = 0, dialogs = 0;
        for (var i = 0; i < comps.length; i++) {
            sumQuality += (comps[i].qualityScore || 0);
            if (comps[i].readmePath) documented++;
            if (comps[i].owner && comps[i].status && comps[i].version) governed++;
            if (comps[i].hasDialog) dialogs++;
        }
        var chips = [
            metricChip(Math.round(sumQuality / total) + "/100", "Avg quality"),
            metricChip(pct(documented, total), "Documented"),
            metricChip(pct(governed, total), "Governed"),
            metricChip(pct(dialogs, total), "Authorable")
        ];
        container.innerHTML = chips.join("");
    }
    function metricChip(value, label) {
        return '<div class="pcl-metric"><span class="pcl-metric__value">' + esc(value) +
            '</span><span class="pcl-metric__label">' + esc(label) + "</span></div>";
    }
    function pct(n, total) { return Math.round((n / total) * 100) + "%"; }
    {{else}}
    function renderMetrics() {}
    {{/if}}

    function getActiveFilter() {
        var active = document.querySelector(".pcl-filter-pill.active");
        return active ? (active.getAttribute("data-filter") || "") : "";
    }

    function bindPills(searchInput) {
        var pills = document.querySelectorAll(".pcl-filter-pill");
        pills.forEach(function (pill) {
            pill.addEventListener("click", function () {
                pills.forEach(function (p) { p.classList.remove("active"); });
                pill.classList.add("active");
                var query = searchInput ? searchInput.value : "";
                applyFilters(query, pill.getAttribute("data-filter") || "", getFacetState());
            });
        });
    }

    function applyFilters(query, category, facets) {
        query = (query || "").toLowerCase().trim();
        facets = facets || {};
        var cards = document.querySelectorAll(".pcl-card");
        var subSections = document.querySelectorAll(".pcl-subcategory-section");
        var sections = document.querySelectorAll(".pcl-category-section");
        var visibleCount = 0;
        cards.forEach(function (card) {
            var title = (card.getAttribute("data-title") || "").toLowerCase();
            var desc = (card.getAttribute("data-desc") || "").toLowerCase();
            var grp = (card.getAttribute("data-group") || "").toLowerCase();
            var cat = card.getAttribute("data-category") || "";
            var sub = (card.getAttribute("data-subcategory") || "").toLowerCase();
            var owner = (card.getAttribute("data-owner") || "").toLowerCase();
            var status = (card.getAttribute("data-status") || "").toLowerCase();
            var quality = parseInt(card.getAttribute("data-quality") || "0", 10);
            var matchSearch = !query || title.indexOf(query) !== -1 || desc.indexOf(query) !== -1 ||
                grp.indexOf(query) !== -1 || cat.toLowerCase().indexOf(query) !== -1 || sub.indexOf(query) !== -1 ||
                owner.indexOf(query) !== -1 || status.indexOf(query) !== -1;
            var matchCategory = !category || cat === category;
            var matchStatus = !facets.status || (card.getAttribute("data-status") || "") === facets.status;
            var matchOwner = !facets.owner || (card.getAttribute("data-owner") || "") === facets.owner;
            var matchQuality = !facets.quality ||
                (facets.quality === "high" ? quality >= 70 : quality < 70);
            var show = matchSearch && matchCategory && matchStatus && matchOwner && matchQuality;
            card.style.display = show ? "" : "none";
            if (show) visibleCount++;
        });
        subSections.forEach(function (sub) {
            var vis = sub.querySelectorAll('.pcl-card:not([style*="display: none"])');
            sub.style.display = vis.length > 0 ? "" : "none";
        });
        sections.forEach(function (section) {
            var vis = section.querySelectorAll('.pcl-card:not([style*="display: none"])');
            section.style.display = vis.length > 0 ? "" : "none";
        });
        var empty = document.querySelector(".pcl-empty");
        if (empty) empty.style.display = visibleCount === 0 ? "" : "none";
    }

    /* ====================================================
       DETAIL VIEW
       ==================================================== */
    function renderDetail(comp) {
        var pagePath = getPagePath();
        var main = document.getElementById("pcl-main");
        var toolbar = document.getElementById("pcl-toolbar");
        if (toolbar) toolbar.style.display = "none";

        var hero = document.querySelector(".pcl-hero");
        if (hero) hero.classList.add("pcl-hero--compact");

        var html = '<div class="pcl-detail">';

        html += '<nav class="pcl-detail__breadcrumb">';
        html += '<a href="' + pagePath + '.html">Component Library</a>';
        html += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>';
        html += "<span>" + esc(comp.title) + "</span>";
        html += "</nav>";

        html += '<div class="pcl-detail__header">';
        html += '<span class="pcl-detail__header-badge">' + esc(comp.category || "General") + " › " + esc(subLabel(comp.subCategory || comp.group)) + "</span>";
        html += '<h1 class="pcl-detail__title">' + esc(comp.title) + "</h1>";
        html += '<p class="pcl-detail__desc">' + esc(comp.description || "A shared component from the " + groupLabel(comp.group) + " group.") + "</p>";
        html += "</div>";

        html += carouselSection(comp);

        html += '<div class="pcl-detail__grid">';
        html += '<div class="pcl-info-card"><h3 class="pcl-info-card__title">Overview</h3>';
        html += infoRow("Category", esc(comp.category || "General"));
        html += infoRow("Sub category", esc(subLabel(comp.subCategory || comp.group)));
        html += infoRow("Used on", esc(comp.usageCount || 0) + ((comp.usageCount === 1) ? " page" : " pages"));
        html += infoRow("Authoring options", esc((comp.dialogFields || []).length));
        html += infoRow("Example images", esc((comp.layouts || []).length));
        html += infoRow("Resource type", "<code>" + esc(comp.resourceType) + "</code>");
        html += "</div>";
        html += '<div class="pcl-info-card"><h3 class="pcl-info-card__title">Authoring options</h3>';
        if (comp.dialogFields && comp.dialogFields.length > 0) {
            html += '<ul class="pcl-fields">';
            for (var fi = 0; fi < comp.dialogFields.length; fi++) {
                var fld = comp.dialogFields[fi];
                html += '<li class="pcl-fields__item"><span class="pcl-fields__name">' + esc(fld.label || fld.name || "Option") + "</span>" +
                    (fld.required ? '<span class="pcl-fields__req">required</span>' : "") + "</li>";
            }
            html += "</ul>";
        } else {
            html += '<p class="pcl-fields__empty">No configurable options \u2014 this component renders as-is.</p>';
        }
        html += "</div></div>";

        html += usageSection(comp);

        html += relationshipsSection(comp, pagePath);

        {{#if features.codeSnippets}}
        html += '<div class="pcl-code-section"><div class="pcl-code-section__header"><h3 class="pcl-code-section__title">HTL Usage</h3><button class="pcl-code-section__copy">Copy</button></div>';
        html += "<pre><code>" + esc('<sly data-sly-resource="${\'' + comp.name + '\' @ resourceType=\'' + comp.resourceType + '\'}"/>') + "</code></pre></div>";

        html += '<div class="pcl-code-section"><div class="pcl-code-section__header"><h3 class="pcl-code-section__title">Content XML</h3><button class="pcl-code-section__copy">Copy</button></div>';
        html += "<pre><code>" + esc("<" + comp.name + "\n    jcr:primaryType=\"nt:unstructured\"\n    sling:resourceType=\"" + comp.resourceType + "\"/>") + "</code></pre></div>";
        {{/if}}

        {{#if features.readme}}
        if (comp.readmePath) {
            html += '<div class="pcl-readme" id="pcl-readme-content"><p>Loading documentation\u2026</p></div>';
        }
        {{/if}}

        html += "</div>";
        main.innerHTML = html;

        {{#if features.readme}}
        if (comp.readmePath) {
            fetch(comp.readmePath)
                .then(function (r) { return r.text(); })
                .then(function (md) {
                    var el = document.getElementById("pcl-readme-content");
                    if (el) el.innerHTML = md2html(md);
                })
                .catch(function () {
                    var el = document.getElementById("pcl-readme-content");
                    if (el) el.innerHTML = "<p>Documentation not available.</p>";
                });
        }
        {{/if}}

        bindCarousel();
        {{#if features.codeSnippets}}
        bindCopyButtons();
        {{/if}}
        {{#if features.lightbox}}
        bindLightbox();
        {{/if}}
    }

    /* ------ preview carousel (one image at a time; desktop / mobile / …) ------ */
    function carouselSection(comp) {
        var imgs = comp.layouts || [];
        if (imgs.length === 0) return "";
        var many = imgs.length > 1;
        var html = '<div class="pcl-carousel" tabindex="0">';
        html += '<div class="pcl-carousel__head"><h3 class="pcl-carousel__title">Preview</h3>' +
            '<span class="pcl-carousel__counter"><b class="pcl-carousel__index">1</b> / ' + imgs.length + "</span></div>";
        html += '<div class="pcl-carousel__viewport">';
        if (many) html += '<button type="button" class="pcl-carousel__nav pcl-carousel__nav--prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>';
        html += '<div class="pcl-carousel__stage">';
        for (var i = 0; i < imgs.length; i++) {
            html += '<img class="pcl-carousel__img' + (i === 0 ? " is-active" : "") + '" src="' + esc(imgs[i].path) + '" alt="' + esc(imgs[i].name) + '" data-name="' + esc(imgs[i].name) + '" loading="lazy"/>';
        }
        html += "</div>";
        if (many) html += '<button type="button" class="pcl-carousel__nav pcl-carousel__nav--next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg></button>';
        html += "</div>";
        html += '<div class="pcl-carousel__caption">' + esc(imgs[0].name) + "</div>";
        if (many) {
            html += '<div class="pcl-carousel__dots">';
            for (var d = 0; d < imgs.length; d++) {
                html += '<button type="button" class="pcl-carousel__dot' + (d === 0 ? " is-active" : "") + '" data-i="' + d + '" aria-label="Image ' + (d + 1) + '"></button>';
            }
            html += "</div>";
        }
        return html + "</div>";
    }

    function bindCarousel() {
        var car = document.querySelector(".pcl-carousel");
        if (!car) return;
        var imgs = car.querySelectorAll(".pcl-carousel__img");
        var dots = car.querySelectorAll(".pcl-carousel__dot");
        var idxEl = car.querySelector(".pcl-carousel__index");
        var cap = car.querySelector(".pcl-carousel__caption");
        var cur = 0;
        function show(i) {
            if (i < 0) i = imgs.length - 1;
            if (i >= imgs.length) i = 0;
            cur = i;
            imgs.forEach(function (im, k) { im.classList.toggle("is-active", k === i); });
            dots.forEach(function (dt, k) { dt.classList.toggle("is-active", k === i); });
            if (idxEl) idxEl.textContent = i + 1;
            if (cap) cap.textContent = imgs[i].getAttribute("data-name");
        }
        var prev = car.querySelector(".pcl-carousel__nav--prev");
        var next = car.querySelector(".pcl-carousel__nav--next");
        if (prev) prev.addEventListener("click", function () { show(cur - 1); });
        if (next) next.addEventListener("click", function () { show(cur + 1); });
        dots.forEach(function (dt) { dt.addEventListener("click", function () { show(parseInt(dt.getAttribute("data-i"), 10)); }); });
        car.addEventListener("keydown", function (e) {
            if (e.key === "ArrowLeft") show(cur - 1);
            if (e.key === "ArrowRight") show(cur + 1);
        });
    }

    function infoRow(label, value) {
        return '<div class="pcl-info-card__row"><span class="pcl-info-card__label">' + esc(label) + '</span><span class="pcl-info-card__value">' + value + "</span></div>";
    }

    /* Where it's used: pages that instantiate this component (from the nightly index). */
    function usageSection(comp) {
        var pages = comp.usages || [];
        var count = comp.usageCount || 0;
        var html = '<div class="pcl-usage-card"><h3 class="pcl-usage-card__title">Where it’s used <span class="pcl-usage-card__count">' + count + "</span></h3>";
        if (pages.length === 0) {
            return html + '<p class="pcl-fields__empty">Not currently used on any page.</p></div>';
        }
        html += '<ul class="pcl-usage-list">';
        for (var i = 0; i < pages.length && i < 250; i++) {
            var p = pages[i];
            html += '<li class="pcl-usage-list__item"><a href="' + esc(p.path) + '.html?wcmmode=disabled" target="_blank" rel="noopener">' +
                '<span class="pcl-usage-list__title">' + esc(p.title || p.path) + "</span>" +
                '<span class="pcl-usage-list__path">' + esc(p.path) + "</span></a></li>";
        }
        html += "</ul>";
        if (pages.length > 250) html += '<p class="pcl-fields__empty">… and ' + (pages.length - 250) + " more</p>";
        return html + "</div>";
    }

    /* Relationships: components that share this component's super type ("built on the
       same core component"), plus same-named variants in other website categories. */
    function relationshipsSection(comp, pagePath) {
        if (!catalogData || !catalogData.components) return "";
        var all = catalogData.components;
        var siblings = [], variants = [];
        var leaf = (comp.name || "").split("/").pop();
        for (var i = 0; i < all.length; i++) {
            var other = all[i];
            if (other.name === comp.name) continue;
            if (comp.superType && other.superType === comp.superType) siblings.push(other);
            else if (leaf && (other.name || "").split("/").pop() === leaf) variants.push(other);
        }
        if (siblings.length === 0 && variants.length === 0) return "";
        var html = '<div class="pcl-relations"><h3 class="pcl-relations__title">Relationships</h3>';
        html += relationGroup("Built on the same core component", comp.superType, siblings, pagePath);
        html += relationGroup("Variants in other categories", leaf, variants, pagePath);
        return html + "</div>";
    }

    function relationGroup(label, hint, list, pagePath) {
        if (!list || list.length === 0) return "";
        var html = '<div class="pcl-relations__group"><h4 class="pcl-relations__label">' + esc(label);
        if (hint) html += ' <code>' + esc(hint) + "</code>";
        html += "</h4><ul class=\"pcl-relations__list\">";
        for (var i = 0; i < list.length && i < 24; i++) {
            var c = list[i];
            html += '<li><a href="' + pagePath + ".html/" + encodeURIComponent(c.name) + '">' +
                esc(c.title) + ' <span class="pcl-relations__cat">' + esc(c.category || "") + "</span></a></li>";
        }
        if (list.length > 24) html += "<li>… and " + (list.length - 24) + " more</li>";
        return html + "</ul></div>";
    }

    function statusDot(yes) {
        return '<span class="pcl-status"><span class="pcl-status__dot pcl-status__dot--' + (yes ? "yes" : "no") + '"></span>' + (yes ? "Yes" : "No") + "</span>";
    }

    {{#if features.codeSnippets}}
    function bindCopyButtons() {
        var btns = document.querySelectorAll(".pcl-code-section__copy");
        btns.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var pre = this.closest(".pcl-code-section").querySelector("pre");
                if (pre && navigator.clipboard) {
                    navigator.clipboard.writeText(pre.textContent).then(function () {
                        btn.textContent = "Copied!";
                        setTimeout(function () { btn.textContent = "Copy"; }, 2000);
                    });
                }
            });
        });
    }
    {{/if}}

    {{#if features.lightbox}}
    function bindLightbox() {
        var lightbox = document.getElementById("pcl-lightbox");
        if (!lightbox) return;
        var items = document.querySelectorAll(".pcl-gallery__item");
        if (items.length === 0) return;

        var lbImg = lightbox.querySelector(".pcl-lightbox__content img");
        var lbCaption = lightbox.querySelector(".pcl-lightbox__caption");
        var lbClose = lightbox.querySelector(".pcl-lightbox__close");
        var lbBackdrop = lightbox.querySelector(".pcl-lightbox__backdrop");
        var lbPrev = lightbox.querySelector(".pcl-lightbox__nav--prev");
        var lbNext = lightbox.querySelector(".pcl-lightbox__nav--next");
        var images = [];
        var current = 0;

        items.forEach(function (item) {
            var img = item.querySelector("img");
            var label = item.querySelector(".pcl-gallery__item-label");
            if (img) images.push({ src: img.src, alt: img.alt, label: label ? label.textContent.trim() : "" });
        });

        function open(idx) {
            if (idx < 0 || idx >= images.length) return;
            current = idx;
            lbImg.src = images[idx].src;
            lbImg.alt = images[idx].alt;
            lbCaption.textContent = images[idx].label || images[idx].alt;
            lightbox.classList.add("active");
            lightbox.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            lbPrev.style.display = current > 0 ? "" : "none";
            lbNext.style.display = current < images.length - 1 ? "" : "none";
        }
        function close() { lightbox.classList.remove("active"); lightbox.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; }

        items.forEach(function (item, idx) { item.addEventListener("click", function () { open(idx); }); });
        lbClose.addEventListener("click", close);
        lbBackdrop.addEventListener("click", close);
        lbPrev.addEventListener("click", function () { open(current - 1); });
        lbNext.addEventListener("click", function () { open(current + 1); });
        document.addEventListener("keydown", function (e) {
            if (!lightbox.classList.contains("active")) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") open(current - 1);
            if (e.key === "ArrowRight") open(current + 1);
        });
    }
    {{/if}}

    /* ====================================================
       INIT
       ==================================================== */
    /* ------ sticky brand bar: reveal on scroll ------ */
    function bindTopbar() {
        var bar = document.getElementById("pcl-topbar");
        if (!bar) return;
        var toggle = function () {
            if (window.pageYOffset > 120) bar.classList.add("pcl-topbar--show");
            else bar.classList.remove("pcl-topbar--show");
        };
        window.addEventListener("scroll", toggle, { passive: true });
        toggle();
    }

    document.addEventListener("DOMContentLoaded", function () {
        bindTopbar();
        var pagePath = getPagePath();
        if (!pagePath) return;

        var endpoint = pagePath + "/_jcr_content.components.json";

        fetchAll(endpoint)
            .then(function (data) {
                catalogData = data;
                var suffix = getSuffix();
                if (suffix) {
                    var found = null;
                    for (var i = 0; i < data.components.length; i++) {
                        if (data.components[i].name === suffix) {
                            found = data.components[i];
                            break;
                        }
                    }
                    if (found) {
                        renderDetail(found);
                    } else {
                        renderListing(data);
                    }
                } else {
                    renderListing(data);
                }
            })
            .catch(function (err) {
                var main = document.getElementById("pcl-main");
                if (main) {
                    main.innerHTML = '<div class="pcl-empty"><svg class="pcl-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><h3 class="pcl-empty__title">Unable to load components</h3><p class="pcl-empty__desc">' + esc(err.message) + "</p></div>";
                }
            });
    });

    function fetchAll(endpoint) {
        var components = [];
        var first = null;
        function next(offset) {
            return fetch(endpoint + "?offset=" + offset + "&limit={{catalog.pageSize}}")
                .then(function (response) {
                    if (!response.ok) throw new Error("Servlet returned " + response.status);
                    return response.json();
                })
                .then(function (page) {
                    if (!first) first = page;
                    components = components.concat(page.components || []);
                    return page.hasMore ? next(offset + (page.components || []).length) : first;
                });
        }
        return next(0).then(function (result) {
            result.components = components;
            return result;
        });
    }

    {{#if features.readme}}
    window.PCL = { md2html: md2html };
    {{/if}}

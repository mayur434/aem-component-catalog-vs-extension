        html += '<div class="pcl-audience-group__body">';
        html += '<div class="pcl-info-card"><h3 class="pcl-info-card__title">Overview</h3>';
        html += infoRow("Category", esc(comp.category || "General"));
        html += infoRow("Sub category", esc(subLabel(comp.subCategory || comp.group)));
        html += infoRow("Used on", esc(comp.usageCount || 0) + ((comp.usageCount === 1) ? " page" : " pages"));
        html += infoRow("Authoring options", esc((comp.dialogFields || []).length));
        html += infoRow("Example images", esc((comp.layouts || []).length));
        html += infoRow("Resource type", "<code>" + esc(comp.resourceType) + "</code>");
        if (comp.formattedUpdatedAt) html += infoRow("Last updated", esc(comp.formattedUpdatedAt));
        if (comp.formattedCreatedAt) html += infoRow("Created", esc(comp.formattedCreatedAt));
        html += "</div>";
        html += usageSection(comp);

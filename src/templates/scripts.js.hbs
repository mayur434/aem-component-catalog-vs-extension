    /* ------ preview carousel (one image at a time; desktop / mobile / …) ------ */
    function carouselSection(comp) {
        var imgs = comp.layouts || [];
        if (imgs.length === 0) return "";
        var many = imgs.length > 1;
        var html = '<div class="pcl-carousel" tabindex="0">';
        html += '<div class="pcl-carousel__head"><h3 class="pcl-carousel__title">Preview</h3>' +
            '<span class="pcl-carousel__counter"><b class="pcl-carousel__index">1</b> / ' + imgs.length + "</span></div>";
        html += '<div class="pcl-carousel__viewport">';
        if (many) html += '<button type="button" class="pcl-carousel__nav pcl-carousel__nav--prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>';
        html += '<div class="pcl-carousel__stage">';
        for (var i = 0; i < imgs.length; i++) {
            html += '<img class="pcl-carousel__img' + (i === 0 ? " is-active" : "") + '" src="' + esc(imgs[i].path) + '" alt="' + esc(imgs[i].name) + '" data-name="' + esc(imgs[i].name) + '" data-type="' + esc(imgs[i].type || "") + '" loading="lazy"/>';
        }
        html += "</div>";
        if (many) html += '<button type="button" class="pcl-carousel__nav pcl-carousel__nav--next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg></button>';
        html += "</div>";
        var firstType = imgs[0].type || "";
        html += '<div class="pcl-carousel__caption">' + (firstType ? '<span class="pcl-carousel__badge pcl-carousel__badge--' + firstType + '">' + firstType.charAt(0).toUpperCase() + firstType.slice(1) + '</span> ' : '') + esc(imgs[0].name) + "</div>";
        if (many) {
            html += '<div class="pcl-carousel__dots">';
            for (var d = 0; d < imgs.length; d++) {
                html += '<button type="button" class="pcl-carousel__dot' + (d === 0 ? " is-active" : "") + '" data-i="' + d + '" aria-label="Image ' + (d + 1) + '"></button>';
            }
            html += "</div>";
        }
        return html + "</div>";
    }

    function bindCarousel() {
        var car = document.querySelector(".pcl-carousel");
        if (!car) return;
        var imgs = car.querySelectorAll(".pcl-carousel__img");
        var dots = car.querySelectorAll(".pcl-carousel__dot");
        var idxEl = car.querySelector(".pcl-carousel__index");
        var cap = car.querySelector(".pcl-carousel__caption");
        var cur = 0;
        function show(i) {
            if (i < 0) i = imgs.length - 1;
            if (i >= imgs.length) i = 0;
            cur = i;
            imgs.forEach(function (im, k) { im.classList.toggle("is-active", k === i); });
            dots.forEach(function (dt, k) { dt.classList.toggle("is-active", k === i); });
            if (idxEl) idxEl.textContent = i + 1;
            if (cap) {
                var imgType = imgs[i].getAttribute("data-type");
                var imgName = imgs[i].getAttribute("data-name");
                cap.innerHTML = (imgType ? '<span class="pcl-carousel__badge pcl-carousel__badge--' + imgType + '">' + imgType.charAt(0).toUpperCase() + imgType.slice(1) + '</span> ' : '') + imgName;
            }
        }
        var prev = car.querySelector(".pcl-carousel__nav--prev");
        var next = car.querySelector(".pcl-carousel__nav--next");
        if (prev) prev.addEventListener("click", function () { show(cur - 1); });
        if (next) next.addEventListener("click", function () { show(cur + 1); });
        dots.forEach(function (dt) { dt.addEventListener("click", function () { show(parseInt(dt.getAttribute("data-i"), 10)); }); });
        car.addEventListener("keydown", function (e) {
            if (e.key === "ArrowLeft") show(cur - 1);
            if (e.key === "ArrowRight") show(cur + 1);
        });
    }

    function infoRow(label, value) {
        return '<div class="pcl-info-card__row"><span class="pcl-info-card__label">' + esc(label) + '</span><span class="pcl-info-card__value">' + value + "</span></div>";
    }

    /* Where it's used: a compact summary + a button that opens the full, scrollable list in a
       modal (the list can run to thousands of pages, so it must not live inline on the page). */
    function usageSection(comp) {
        var count = comp.usageCount || 0;
        var html = '<div class="pcl-usage-card"><div class="pcl-usage-card__head">' +
            '<h3 class="pcl-usage-card__title">Where it’s used <span class="pcl-usage-card__count">' + count + "</span></h3>";
        if (count > 0) {
            html += '<button type="button" class="pcl-usage-card__view" data-usage-open>' +
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>' +
                "View all pages</button>";
        }
        html += "</div>";
        html += count > 0
            ? '<p class="pcl-usage-card__hint">Instantiated on ' + count + (count === 1 ? " page" : " pages") + " across the sites. Open the list to browse and jump to any page.</p>"
            : '<p class="pcl-fields__empty">Not currently used on any page.</p>';
        return html + "</div>";
    }

    /* ------ "Where it's used" modal (shared, scrollable, filterable) ------ */
    var usagePages = [];
    var usageLabel = "";
    var usageModalReady = false;

    function usageRow(p) {
        return '<li class="pcl-usage-modal__item"><a href="' + esc(p.path) + '.html?wcmmode=disabled" target="_blank" rel="noopener">' +
            '<span class="pcl-usage-modal__item-title">' + esc(p.title || p.path) + "</span>" +
            '<span class="pcl-usage-modal__item-path">' + esc(p.path) + "</span></a></li>";
    }

    function renderUsageRows(query) {
        var list = document.getElementById("pcl-usage-modal-list");
        if (!list) return;
        var needle = (query || "").toLowerCase();
        var out = "", shown = 0;
        for (var i = 0; i < usagePages.length; i++) {
            var p = usagePages[i];
            if (needle) {
                var hay = ((p.title || "") + " " + p.path).toLowerCase();
                if (hay.indexOf(needle) < 0) continue;
            }
            out += usageRow(p);
            shown++;
        }
        list.innerHTML = out || '<li class="pcl-usage-modal__empty">No pages match your filter.</li>';
        var countEl = document.getElementById("pcl-usage-modal-count");
        if (countEl) countEl.textContent = shown === usagePages.length ? shown : shown + " / " + usagePages.length;
    }

    function openUsageModal() {
        var modal = document.getElementById("pcl-usage-modal");
        if (!modal) return;
        var titleEl = modal.querySelector(".pcl-usage-modal__title");
        var filterEl = modal.querySelector(".pcl-usage-modal__filter");
        if (titleEl) titleEl.textContent = "Where it’s used" + (usageLabel ? " — " + usageLabel : "");
        if (filterEl) filterEl.value = "";
        renderUsageRows("");
        modal.classList.add("pcl-usage-modal--open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        if (filterEl) filterEl.focus();
    }

    function closeUsageModal() {
        var modal = document.getElementById("pcl-usage-modal");
        if (!modal) return;
        modal.classList.remove("pcl-usage-modal--open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    function ensureUsageModal() {
        if (usageModalReady) return;
        var modal = document.getElementById("pcl-usage-modal");
        if (!modal) return;
        var closeEl = modal.querySelector(".pcl-usage-modal__close");
        var backdrop = modal.querySelector(".pcl-usage-modal__backdrop");
        var filterEl = modal.querySelector(".pcl-usage-modal__filter");
        if (closeEl) closeEl.addEventListener("click", closeUsageModal);
        if (backdrop) backdrop.addEventListener("click", closeUsageModal);
        if (filterEl) filterEl.addEventListener("input", function () { renderUsageRows(filterEl.value); });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && modal.classList.contains("pcl-usage-modal--open")) closeUsageModal();
        });
        usageModalReady = true;
    }

    function bindUsageModal(comp) {
        ensureUsageModal();
        usagePages = comp.usages || [];
        usageLabel = comp.title || comp.name || "";
        var openers = document.querySelectorAll("[data-usage-open]");
        for (var i = 0; i < openers.length; i++) openers[i].addEventListener("click", openUsageModal);
    }

    /* Relationships: components that share this component's super type ("built on the
       same core component"), plus same-named variants in other website categories. */
    function relationshipsSection(comp, pagePath) {
        if (!catalogData || !catalogData.components) return "";
        var all = catalogData.components;
        var siblings = [], variants = [];
        var leaf = (comp.name || "").split("/").pop();
        for (var i = 0; i < all.length; i++) {
            var other = all[i];
            if (other.name === comp.name) continue;
            if (comp.superType && other.superType === comp.superType) siblings.push(other);
            else if (leaf && (other.name || "").split("/").pop() === leaf) variants.push(other);
        }
        if (siblings.length === 0 && variants.length === 0) return "";
        var html = '<div class="pcl-relations"><h3 class="pcl-relations__title">Relationships</h3>';
        html += relationGroup("Built on the same core component", comp.superType, siblings, pagePath);
        html += relationGroup("Variants in other categories", leaf, variants, pagePath);
        return html + "</div>";
    }

    function relationGroup(label, hint, list, pagePath) {
        if (!list || list.length === 0) return "";
        var html = '<div class="pcl-relations__group"><h4 class="pcl-relations__label">' + esc(label);
        if (hint) html += ' <code>' + esc(hint) + "</code>";
        html += "</h4><ul class=\"pcl-relations__list\">";
        for (var i = 0; i < list.length && i < 24; i++) {
            var c = list[i];
            html += '<li><a href="' + pagePath + ".html/" + encodeURIComponent(c.name) + '">' +
                esc(c.title) + ' <span class="pcl-relations__cat">' + esc(c.category || "") + "</span></a></li>";
        }
        if (list.length > 24) html += "<li>… and " + (list.length - 24) + " more</li>";
        return html + "</ul></div>";
    }

    function statusDot(yes) {
        return '<span class="pcl-status"><span class="pcl-status__dot pcl-status__dot--' + (yes ? "yes" : "no") + '"></span>' + (yes ? "Yes" : "No") + "</span>";
    }

    {{#if features.codeSnippets}}
    function bindCopyButtons() {
        var btns = document.querySelectorAll(".pcl-code-section__copy");
        btns.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var pre = this.closest(".pcl-code-section").querySelector("pre");
                if (pre && navigator.clipboard) {
                    navigator.clipboard.writeText(pre.textContent).then(function () {
                        btn.textContent = "Copied!";
                        setTimeout(function () { btn.textContent = "Copy"; }, 2000);
                    });
                }
            });
        });
    }
    {{/if}}

    {{#if features.lightbox}}
    function bindLightbox() {
        var lightbox = document.getElementById("pcl-lightbox");
        if (!lightbox) return;
        var items = document.querySelectorAll(".pcl-carousel__img");
        if (items.length === 0) return;

        var lbImg = lightbox.querySelector(".pcl-lightbox__content img");
        var lbCaption = lightbox.querySelector(".pcl-lightbox__caption");
        var lbClose = lightbox.querySelector(".pcl-lightbox__close");
        var lbBackdrop = lightbox.querySelector(".pcl-lightbox__backdrop");
        var lbPrev = lightbox.querySelector(".pcl-lightbox__nav--prev");
        var lbNext = lightbox.querySelector(".pcl-lightbox__nav--next");
        var images = [];
        var current = 0;

        items.forEach(function (item) {
            images.push({ src: item.src, alt: item.alt, label: item.dataset.name || item.alt || "", type: item.dataset.type || "" });
        });

        function open(idx) {
            if (idx < 0 || idx >= images.length) return;
            current = idx;
            lbImg.src = images[idx].src;
            lbImg.alt = images[idx].alt;
            var t = images[idx].type;
            lbCaption.innerHTML = (t ? '<span class="pcl-carousel__badge pcl-carousel__badge--' + t + '">' + t.charAt(0).toUpperCase() + t.slice(1) + '</span> ' : '') + (images[idx].label || images[idx].alt);
            lightbox.classList.add("pcl-lightbox--open");
            lightbox.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
            lbPrev.style.display = current > 0 ? "" : "none";
            lbNext.style.display = current < images.length - 1 ? "" : "none";
        }
        function close() { lightbox.classList.remove("pcl-lightbox--open"); lightbox.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; }

        items.forEach(function (item, idx) { item.addEventListener("click", function () { open(idx); }); });
        lbClose.addEventListener("click", close);
        lbBackdrop.addEventListener("click", close);
        lbPrev.addEventListener("click", function () { open(current - 1); });
        lbNext.addEventListener("click", function () { open(current + 1); });
        document.addEventListener("keydown", function (e) {
            if (!lightbox.classList.contains("pcl-lightbox--open")) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") open(current - 1);
            if (e.key === "ArrowRight") open(current + 1);
        });
    }
    {{/if}}

    /* ====================================================
       KEYBOARD SHORTCUTS — global navigation
       ==================================================== */
    function bindKeyboardShortcuts() {
        var input = document.querySelector(".pcl-search__input");
        var helpModal = document.getElementById("pcl-shortcuts-modal");
        var focusedIdx = -1;

        function getVisibleCards() {
            var arr = [];
            document.querySelectorAll(".pcl-card").forEach(function (c) { if (c.style.display !== "none") arr.push(c); });
            return arr;
        }

        function setCardFocus(visible, idx) {
            visible.forEach(function (c) { c.classList.remove("pcl-card--focused"); });
            if (idx >= 0 && idx < visible.length) {
                visible[idx].classList.add("pcl-card--focused");
                visible[idx].scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
        }

        document.addEventListener("keydown", function (e) {
            var tag = e.target.tagName;
            var isInput = tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || e.target.isContentEditable;
            var anyModalOpen = document.querySelector(".pcl-lightbox--open, .pcl-usage-modal--open");

            if (e.key === "Escape") {
                if (helpModal && helpModal.classList.contains("pcl-shortcuts--open")) {
                    helpModal.classList.remove("pcl-shortcuts--open"); e.preventDefault(); return;
                }
                if (isInput && input) {
                    input.value = ""; input.dispatchEvent(new Event("input")); input.blur();
                    focusedIdx = -1; setCardFocus(getVisibleCards(), -1); e.preventDefault(); return;
                }
            }
            if (anyModalOpen) return;
            if (!isInput) {
                if (e.key === "/") { e.preventDefault(); if (input) input.focus(); return; }
                if (e.key === "?") { e.preventDefault(); if (helpModal) helpModal.classList.toggle("pcl-shortcuts--open"); return; }
                if (e.key === "f" && !e.ctrlKey && !e.metaKey) {
                    var favPill = document.querySelector(".pcl-pill--fav");
                    if (favPill) { favPill.click(); e.preventDefault(); }
                    return;
                }
            }
            if (input && document.activeElement === input) {
                var visible = getVisibleCards();
                if (e.key === "ArrowDown") { e.preventDefault(); focusedIdx = Math.min(focusedIdx + 1, visible.length - 1); setCardFocus(visible, focusedIdx); }
                else if (e.key === "ArrowUp") { e.preventDefault(); focusedIdx = Math.max(focusedIdx - 1, 0); setCardFocus(visible, focusedIdx); }
                else if (e.key === "Enter" && focusedIdx >= 0 && focusedIdx < visible.length) { e.preventDefault(); visible[focusedIdx].click(); }
            }
        });
    }

    function bindShortcutsModal() {
        var modal = document.getElementById("pcl-shortcuts-modal");
        if (!modal) return;
        var closeBtn = modal.querySelector(".pcl-shortcuts-modal__close");
        var backdrop = modal.querySelector(".pcl-shortcuts-modal__backdrop");
        function closeModal() { modal.classList.remove("pcl-shortcuts--open"); }
        if (closeBtn) closeBtn.addEventListener("click", closeModal);
        if (backdrop) backdrop.addEventListener("click", closeModal);
    }

    /* ====================================================
       INIT
       ==================================================== */
    /* ------ sticky brand bar: reveal on scroll ------ */
    function bindTopbar() {
        var bar = document.getElementById("pcl-topbar");
        if (!bar) return;
        var toggle = function () {
            bar.classList.toggle("pcl-topbar--visible", window.scrollY > 200);
        };
        window.addEventListener("scroll", toggle, { passive: true });
        toggle();
    }

    document.addEventListener("DOMContentLoaded", function () {
        bindTopbar();
        bindKeyboardShortcuts();
        bindShortcutsModal();
        var pagePath = getPagePath();
        if (!pagePath) return;

        var endpoint = pagePath + "/_jcr_content.components.json";

        fetchAll(endpoint)
            .then(function (data) {
                catalogData = data;
                var suffix = getSuffix();
                if (suffix) {
                    var found = null;
                    for (var i = 0; i < data.components.length; i++) {
                        if (data.components[i].name === suffix) {
                            found = data.components[i];
                            break;
                        }
                    }
                    if (found) {
                        renderDetail(found);
                    } else {
                        renderListing(data);
                    }
                } else {
                    renderListing(data);
                }
            })
            .catch(function (err) {
                var main = document.getElementById("pcl-main");
                if (main) {
                    main.innerHTML = '<div class="pcl-empty"><svg class="pcl-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><h3 class="pcl-empty__title">Unable to load components</h3><p class="pcl-empty__desc">' + esc(err.message) + "</p></div>";
                }
            });
    });

    function fetchAll(endpoint) {
        var components = [];
        var first = null;
        function next(offset) {
            return fetch(endpoint + "?offset=" + offset + "&limit={{catalog.pageSize}}")
                .then(function (response) {
                    if (!response.ok) throw new Error("Servlet returned " + response.status);
                    return response.json();
                })
                .then(function (page) {
                    if (!first) first = page;
                    components = components.concat(page.components || []);
                    return page.hasMore ? next(offset + (page.components || []).length) : first;
                });
        }
        return next(0).then(function (result) {
            result.components = components;
            return result;
        });
    }


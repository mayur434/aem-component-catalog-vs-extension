        html += '<div class="pcl-audience-group pcl-audience-group--authors">';
        html += '<div class="pcl-audience-group__head"><span class="pcl-audience-group__eyebrow">For Authors</span>' +
            '<p class="pcl-audience-group__desc">Configuration available when adding this component to a page.</p></div>';
        html += '<div class="pcl-audience-group__body">';
        html += '<div class="pcl-info-card"><h3 class="pcl-info-card__title">Authoring options</h3>';
        if (comp.dialogFields && comp.dialogFields.length > 0) {
            html += '<ul class="pcl-fields">';
            for (var fi = 0; fi < comp.dialogFields.length; fi++) {
                var fld = comp.dialogFields[fi];
                html += '<li class="pcl-fields__item"><span class="pcl-fields__name">' + esc(fld.label || fld.name || "Option") + "</span>" +
                    (fld.required ? '<span class="pcl-fields__req">required</span>' : "") + "</li>";
            }
            html += "</ul>";
        } else {
            html += '<p class="pcl-fields__empty">No configurable options \u2014 this component renders as-is.</p>';
        }
        html += "</div></div></div>";

        html += '<div class="pcl-audience-group pcl-audience-group--tech">';
        html += '<div class="pcl-audience-group__head"><span class="pcl-audience-group__eyebrow">For Tech</span>' +
            '<p class="pcl-audience-group__desc">Implementation details \u2014 relationships, inheritance, and code snippets.</p></div>';
        html += '<div class="pcl-audience-group__body">';

        html += relationshipsSection(comp, pagePath);

        if (comp.superTypeChain && comp.superTypeChain.length > 0) {
            html += '<div class="pcl-dep-chain"><h3 class="pcl-dep-chain__title">Inheritance Chain</h3>';
            html += '<div class="pcl-dep-chain__flow">';
            for (var ci2 = 0; ci2 < comp.superTypeChain.length; ci2++) {
                var isLast = ci2 === comp.superTypeChain.length - 1;
                html += '<div class="pcl-dep-chain__node' + (isLast ? ' pcl-dep-chain__node--current' : '') + '"><code>' + esc(comp.superTypeChain[ci2]) + '</code></div>';
                if (!isLast) {

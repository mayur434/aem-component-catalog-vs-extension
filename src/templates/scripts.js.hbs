/* ============================================================
   {{appId}} — Component Library (auto-discovery)
   Fetches servlet JSON, renders listing grid with group filters,
   and renders detail view via URL suffix.

   Generated by AEM Component Library Generator.
   ============================================================ */
(function () {
    "use strict";

    /* Full catalog dataset, shared between listing, facets, and detail relationships. */
    var catalogData = null;
    /* leaf component name -> count of distinct categories (sites) instantiating it. */
    var reuseCounts = {};

    /* ------ helpers ------ */
    function esc(s) { var d = document.createElement("div"); d.textContent = String(s == null ? "" : s); return d.innerHTML; }

    /* ------ fuzzy search — Levenshtein distance + scoring ------ */
    function levenshtein(a, b) {
        if (a.length === 0) return b.length;
        if (b.length === 0) return a.length;
        var matrix = [];
        for (var i = 0; i <= b.length; i++) matrix[i] = [i];
        for (var j = 0; j <= a.length; j++) matrix[0][j] = j;
        for (i = 1; i <= b.length; i++) {
            for (j = 1; j <= a.length; j++) {
                var cost = b.charAt(i - 1) === a.charAt(j - 1) ? 0 : 1;
                matrix[i][j] = Math.min(matrix[i - 1][j] + 1, matrix[i][j - 1] + 1, matrix[i - 1][j - 1] + cost);
            }
        }
        return matrix[b.length][a.length];
    }

    function fuzzyScore(needle, haystack) {
        if (!needle) return 100;
        var n = needle.toLowerCase(), h = haystack.toLowerCase();
        if (h === n) return 100;
        if (h.indexOf(n) === 0) return 90;
        if (h.indexOf(n) >= 0) return 80;
        var words = h.split(/\s+/);
        for (var i = 0; i < words.length; i++) { if (words[i].indexOf(n) === 0) return 75; }
        var threshold = Math.floor(n.length * 0.4);
        for (i = 0; i < words.length; i++) {
            if (levenshtein(n, words[i].substring(0, n.length + 2)) <= threshold) return 60;
        }
        if (n.length >= 3 && levenshtein(n, h.substring(0, n.length + 2)) <= threshold) return 50;
        return 0;
    }

    function highlightText(text, needle) {
        if (!needle || needle.length < 2) return esc(text);
        var idx = text.toLowerCase().indexOf(needle.toLowerCase());
        if (idx < 0) return esc(text);
        return esc(text.substring(0, idx)) + '<mark class="pcl-highlight">' + esc(text.substring(idx, idx + needle.length)) + '</mark>' + esc(text.substring(idx + needle.length));
    }

    /* ------ toast — brief notifications ------ */
    function showToast(msg) {
        var el = document.getElementById("pcl-toast");
        if (!el) return;
        el.textContent = msg;
        el.classList.add("pcl-toast--visible");
        clearTimeout(el._timer);
        el._timer = setTimeout(function () { el.classList.remove("pcl-toast--visible"); }, 2000);
    }

    /* ------ URL state — deep-linkable filters ------ */
    function readUrlState() {
        var params = new URLSearchParams(window.location.search);
        return { search: params.get("search") || "", category: params.get("category") || "", sort: params.get("sort") || "", favorites: params.get("favorites") === "1", searchScope: params.get("scope") || "all" };
    }

    function writeUrlState(updates) {
        var url = new URL(window.location.href);
        Object.keys(updates).forEach(function (key) {
            var val = updates[key];
            if (!val || val === "all" || val === false) { url.searchParams.delete(key); }
            else if (val === true) { url.searchParams.set(key, "1"); }
            else { url.searchParams.set(key, val); }
        });
        history.replaceState(null, "", url.toString());
    }

    /* ------ favorites — localStorage bookmarks ------ */
    var FAVORITES_KEY = "pcl-favorites";
    function getFavorites() { try { return JSON.parse(localStorage.getItem(FAVORITES_KEY)) || []; } catch (e) { return []; } }
    function toggleFavorite(name) {
        var favs = getFavorites();
        var idx = favs.indexOf(name);
        if (idx >= 0) { favs.splice(idx, 1); } else { favs.push(name); }
        localStorage.setItem(FAVORITES_KEY, JSON.stringify(favs));
        return idx < 0;
    }
    function isFavorite(name) { return getFavorites().indexOf(name) >= 0; }

    function bindFavorites() {
        var cards = document.querySelectorAll(".pcl-card");
        cards.forEach(function (card) {
            var star = card.querySelector(".pcl-card__fav");
            if (!star) return;
            var name = card.getAttribute("data-name") || "";
            if (isFavorite(name)) {
                star.classList.add("pcl-card__fav--active");
                star.setAttribute("aria-label", "Remove from favorites");
            }
            star.addEventListener("click", function (e) {
                e.preventDefault(); e.stopPropagation();
                var isNowFav = toggleFavorite(name);
                star.classList.toggle("pcl-card__fav--active", isNowFav);
                star.setAttribute("aria-label", isNowFav ? "Remove from favorites" : "Add to favorites");
                showToast(isNowFav ? "Added to favorites" : "Removed from favorites");
            });
        });
    }

    /* Strips a leading "<App Id> - " prefix (dash/space tolerant, any dash glyph) from group
       labels like "Pidilite Component Library - Content" -> "Content". Built from {{appId}} at
       runtime rather than embedded as template-generated regex source, which is fragile to escape. */
    var APP_PREFIX_RE = (function () {
        var escaped = String({{json appId}}).replace(/[.*+?^${}()|[\]\\]/g, "\\$&").replace(/[-\s]+/g, "[-\\s]+");
        return new RegExp("^" + escaped + "\\s*[-\\u2013\\u2014]\\s*", "i");
    })();

    function groupLabel(g) {
        var s = String(g == null ? "" : g);
        var stripped = s.replace(APP_PREFIX_RE, "").trim();
        return stripped || s.trim();
    }

    function groupSlug(g) {
        return groupLabel(g).toLowerCase().replace(/[^a-z0-9_-]+/g, "-");
    }

    function badgeClass(g) {
        var slug = groupSlug(g);
        return "pcl-card__badge--" + slug;
    }

    function getSuffix() {
        var path = window.location.pathname;
        var idx = path.indexOf(".html/");
        if (idx === -1) return null;
        var suffix = path.substring(idx + 6);
        return suffix ? decodeURIComponent(suffix) : null;
    }

    function getPagePath() {
        var lib = document.querySelector(".pcl-library[data-page-path]");
        return lib ? lib.getAttribute("data-page-path") : "";
    }

    {{#if features.readme}}
    /* ------ Markdown to HTML ------ */
    function md2html(md) {
        var h = esc(md);
        h = h.replace(/```(\w*)\n([\s\S]*?)```/g, function (_, lang, code) {
            return '<pre><code class="language-' + lang + '">' + code.trim() + "</code></pre>";
        });
        h = h.replace(/`([^`]+)`/g, "<code>$1</code>");
        h = h.replace(/^#### (.+)$/gm, "<h4>$1</h4>");
        h = h.replace(/^### (.+)$/gm, "<h3>$1</h3>");
        h = h.replace(/^## (.+)$/gm, "<h2>$1</h2>");
        h = h.replace(/^# (.+)$/gm, "<h1>$1</h1>");
        h = h.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
        h = h.replace(/\*([^*]+)\*/g, "<em>$1</em>");
        h = h.replace(/^> (.+)$/gm, "<blockquote>$1</blockquote>");
        h = h.replace(/^---$/gm, "<hr/>");
        h = h.replace(/^\|(.+)\|$/gm, function (line) {
            if (/^\|[\s\-:|]+\|$/.test(line)) return "<!--sep-->";
            var cells = line.split("|").filter(function (c) { return c.trim() !== ""; });
            return "<tr>" + cells.map(function (c) { return "<td>" + c.trim() + "</td>"; }).join("") + "</tr>";
        });
        h = h.replace(/((<tr>.*<\/tr>\n?)+)/g, function (rows) {
            var first = rows.indexOf("</tr>");
            var head = rows.substring(0, first + 5).replace(/<td>/g, "<th>").replace(/<\/td>/g, "</th>");
            var body = rows.substring(first + 5).replace(/<!--sep-->\n?/g, "");
            return "<table><thead>" + head + "</thead><tbody>" + body + "</tbody></table>";
        });
        h = h.replace(/^- (.+)$/gm, "<li>$1</li>");
        h = h.replace(/(<li>.*<\/li>\n?)+/g, function (m) { return "<ul>" + m + "</ul>"; });
        h = h.replace(/^(?!<[a-z/!])((?!^\s*$).+)$/gm, "<p>$1</p>");
        h = h.replace(/\n{3,}/g, "\n\n");
        return h;
    }
    {{/if}}

    /* ====================================================
       LISTING VIEW
       ==================================================== */
    function subLabel(sub) {
        // Curated sub-categories are already friendly; group values get the appId prefix stripped.
        return groupLabel(String(sub == null ? "" : sub));
    }

    /* How broadly a component is adopted across the brand portfolio: distinct categories
       (sites) that contain a component with the same leaf name. Recomputed whenever the
       full dataset is (re)rendered; cheap for catalog-sized component counts. */
    function computeReuseCounts(components) {
        var byLeaf = {};
        for (var i = 0; i < components.length; i++) {
            var c = components[i];
            var leaf = String(c.name || "").split("/").pop();
            if (!byLeaf[leaf]) byLeaf[leaf] = {};
            byLeaf[leaf][c.category || ""] = true;
        }
        var counts = {};
        for (var leaf2 in byLeaf) {
            if (byLeaf.hasOwnProperty(leaf2)) counts[leaf2] = Object.keys(byLeaf[leaf2]).length;
        }
        return counts;
    }

    /* "customProductTeaser" / "custom-product-teaser" / "custom_product_teaser" -> "Custom Product Teaser". */
    function humanizeSegment(seg) {
        var spaced = String(seg || "")
            .replace(/[_-]+/g, " ")
            .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
            .replace(/\s+/g, " ")
            .trim();
        return spaced.replace(/\S+/g, function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); });
    }

    /* Most components ship without an authored jcr:description; a single repeated boilerplate
       sentence on most cards reads as broken UI. Derive a real, per-component sentence instead:
       the folder grouping when there is one, otherwise the type + site. */
    function fallbackDescription(comp, category, sub) {
        var segments = String(comp.name || "").split("/");
        var middle = segments.slice(1, -1).map(humanizeSegment).filter(Boolean);
        if (middle.length > 0) {
            return "Part of the " + middle.join(" › ") + " component set in " + category + ".";
        }
        return "A " + groupLabel(sub || comp.group || "Content") + " component for " + category + ".";
    }

    function renderCard(comp, pagePath, category, sub) {
        var href = pagePath + ".html/" + encodeURIComponent(comp.name);
        var hasThumbnail = !!comp.thumbnailPath;
        var uc = comp.usageCount || 0;
        var fieldNames = (comp.dialogFields || []).map(function (f) { return f.label || f.name || ""; }).join(", ");
        var tagsList = (comp.tags || []).join(", ");
        var html = '<a class="pcl-card' + (uc === 0 ? ' pcl-card--unused' : '') + '" href="' + href + '" data-title="' + esc(comp.title) + '" data-desc="' + esc(comp.description) + '" data-group="' + esc(comp.group) + '" data-category="' + esc(category) + '" data-subcategory="' + esc(sub) + '" data-owner="' + esc(comp.owner) + '" data-status="' + esc(comp.status) + '" data-quality="' + esc(comp.qualityScore == null ? "" : comp.qualityScore) + '" data-name="' + esc(comp.name) + '" data-usage="' + uc + '" data-fields="' + esc(fieldNames) + '" data-tags="' + esc(tagsList) + '">';
        html += '<button type="button" class="pcl-card__fav" aria-label="Add to favorites"><svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></button>';
        html += '<div class="pcl-card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></div>';
        if (hasThumbnail) {
            html += '<div class="pcl-card__preview pcl-card__preview--has-thumb"><img class="pcl-card__thumb" src="' + esc(comp.thumbnailPath) + '" alt="' + esc(comp.title) + '" width="400" height="225" loading="lazy"/></div>';
        } else {
            html += '<div class="pcl-card__preview"><div class="pcl-card__preview-pattern"></div><div class="pcl-card__preview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></div></div>';
        }
        html += '<div class="pcl-card__body">';
        html += '<div class="pcl-card__header"><h3 class="pcl-card__title">' + esc(comp.title) + '</h3><span class="pcl-card__badge ' + badgeClass(comp.group) + '">' + esc(subLabel(sub)) + "</span></div>";
        html += '<p class="pcl-card__desc">' + esc(comp.description || fallbackDescription(comp, category, sub)) + "</p>";
        html += '<div class="pcl-card__meta">';
        html += '<span class="pcl-card__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>' + esc(category) + " \u203a " + esc(subLabel(sub)) + "</span>";
        var uc = comp.usageCount || 0;
        html += '<span class="pcl-card__meta-item pcl-usage' + (uc > 0 ? "" : " pcl-usage--none") + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' + (uc > 0 ? (uc + (uc === 1 ? " page" : " pages")) : "Unused") + "</span>";
        var reuse = reuseCounts[String(comp.name || "").split("/").pop()] || 1;
        if (reuse > 1) {
            html += '<span class="pcl-card__meta-item pcl-reuse"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>Used in ' + reuse + ' sites</span>';
        }
        if (comp.layouts && comp.layouts.length > 0) {
            html += '<span class="pcl-card__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>' + comp.layouts.length + ' example' + (comp.layouts.length > 1 ? 's' : '') + '</span>';
        }
        html += "</div></div></a>";
        return html;
    }

    function renderListing(data) {
        reuseCounts = computeReuseCounts(data.components || []);
        var pagePath = getPagePath();
        var main = document.getElementById("pcl-main");
        var toolbar = document.getElementById("pcl-toolbar");
        var pillsContainer = document.getElementById("pcl-filter-pills");
        var categories = data.categories || {};

        var totalEl = document.getElementById("pcl-total-count");
        var catEl = document.getElementById("pcl-category-count");
        if (totalEl) totalEl.textContent = data.total;
        if (catEl) catEl.textContent = Object.keys(categories).length;

        toolbar.style.display = "";
        var totalEl2 = document.getElementById("pcl-results-total");
        if (totalEl2) totalEl2.textContent = data.total;

        var urlState = readUrlState();
        var activeCategory = urlState.category || "";
        var pillsHtml = '<button class="pcl-pill' + (!activeCategory ? ' pcl-pill--active' : '') + '" data-filter="">All <span class="pcl-pill__count">' + data.total + "</span></button>";
        pillsHtml += '<button class="pcl-pill pcl-pill--fav' + (urlState.favorites ? ' pcl-pill--active' : '') + '" data-filter="__favorites__">★ Favorites</button>';
        var catNames = Object.keys(categories).sort();
        for (var ci = 0; ci < catNames.length; ci++) {
            var cn = catNames[ci];
            pillsHtml += '<button class="pcl-pill' + (activeCategory === cn ? ' pcl-pill--active' : '') + '" data-filter="' + esc(cn) + '">' +
                esc(cn) + ' <span class="pcl-pill__count">' + categories[cn] + "</span></button>";
        }
        pillsContainer.innerHTML = pillsHtml;

        {{#if features.qualityScore}}
        renderFacets(data.components);
        renderMetrics(data);
        {{/if}}

        renderSections(data, getSortMode());

        var searchInput = document.querySelector(".pcl-search__input");
        var scopeSelect = document.getElementById("pcl-search-scope");
        if (urlState.search && searchInput) {
            searchInput.value = urlState.search;
            _searchState.needle = urlState.search;
        }
        if (urlState.searchScope && scopeSelect) {
            scopeSelect.value = urlState.searchScope;
            _searchState.scope = urlState.searchScope;
        }
        if (urlState.favorites) _searchState.showFavOnly = true;

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                _searchState.needle = this.value.trim();
                writeUrlState({ search: _searchState.needle });
                applyFilters(this.value, getActiveFilter(), getFacetState());
            });
        }
        if (scopeSelect) {
            scopeSelect.addEventListener("change", function () {
                _searchState.scope = this.value;
                writeUrlState({ scope: _searchState.scope });
                applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
            });
        }
        bindPills(searchInput);
        bindFacets(searchInput);
        bindSort(searchInput, data);
        bindFavorites();

        var hasActiveFilter = urlState.search || (urlState.searchScope && urlState.searchScope !== "all") || urlState.favorites || urlState.category;
        if (hasActiveFilter) applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
    }

    /* ------ sorting (default: usage high -> low) ------ */
    function usageOf(c) { return c.usageCount || 0; }
    function getSortMode() { var el = document.getElementById("pcl-sort"); return el ? el.value : "usage"; }
    function cardCompare(mode) {
        return function (a, b) {
            if (mode === "updated") {
                var ta = a.lastModified || a.formattedUpdatedAt || "";
                var tb = b.lastModified || b.formattedUpdatedAt || "";
                if (ta !== tb) return ta > tb ? -1 : 1;
            }
            if (mode === "usage") { var d = usageOf(b) - usageOf(a); if (d) return d; }
            return String(a.title || "").localeCompare(String(b.title || ""));
        };
    }
    function sumUsage(list) { var s = 0; for (var i = 0; i < list.length; i++) s += usageOf(list[i]); return s; }

    function renderSections(data, mode) {
        var pagePath = getPagePath();
        var main = document.getElementById("pcl-main");
        var byCategory = {};
        var components = data.components;
        for (var i = 0; i < components.length; i++) {
            var c = components[i];
            var cat = c.category || "General";
            var sub = c.subCategory || c.group || "Other";
            if (!byCategory[cat]) byCategory[cat] = {};
            if (!byCategory[cat][sub]) byCategory[cat][sub] = [];
            byCategory[cat][sub].push(c);
        }
        var cats = Object.keys(byCategory);
        var catUsage = {};
        for (var a = 0; a < cats.length; a++) {
            var acc = 0, subsA = byCategory[cats[a]];
            for (var kk in subsA) { if (subsA.hasOwnProperty(kk)) acc += sumUsage(subsA[kk]); }
            catUsage[cats[a]] = acc;
        }
        if (mode === "usage") {
            cats.sort(function (x, y) { var d = catUsage[y] - catUsage[x]; return d || x.localeCompare(y); });
        } else { cats.sort(); }

        var html = "";
        for (var ck = 0; ck < cats.length; ck++) {
            var category = cats[ck];
            var subs = byCategory[category];
            var subNames = orderSubs(subs, mode);
            var catTotal = 0;
            for (var s0 = 0; s0 < subNames.length; s0++) catTotal += subs[subNames[s0]].length;
            html += '<section class="pcl-category-section" data-category="' + esc(category) + '">';
            html += '<h2 class="pcl-section-title">' + esc(category) + ' <span class="pcl-section-title__count">' + catTotal + '</span></h2>';
            for (var sk = 0; sk < subNames.length; sk++) {
                var sub = subNames[sk];
                var list = subs[sub].slice().sort(cardCompare(mode));
                html += '<div class="pcl-subcategory-section" data-subcategory="' + esc(sub) + '">';
                html += '<h3 class="pcl-subcategory-title">' + esc(subLabel(sub)) + ' <span class="pcl-subcategory-title__count">' + list.length + '</span></h3>';
                html += '<div class="pcl-grid">';
                for (var j = 0; j < list.length; j++) {
                    html += renderCard(list[j], pagePath, category, sub);
                }
                html += "</div></div>";
            }
            html += "</section>";
        }
        html += '<div class="pcl-empty" style="display:none;"><svg class="pcl-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg><h3 class="pcl-empty__title">No components found</h3><p class="pcl-empty__desc">Try adjusting your search or filter criteria.</p></div>';
        main.innerHTML = html;
    }

    function orderSubs(subs, mode) {
        var names = Object.keys(subs);
        if (mode === "usage") {
            names.sort(function (x, y) { var d = sumUsage(subs[y]) - sumUsage(subs[x]); return d || x.localeCompare(y); });
        } else { names.sort(); }
        return names;
    }

    function bindSort(searchInput, data) {
        var el = document.getElementById("pcl-sort");
        if (!el) return;
        el.addEventListener("change", function () {
            renderSections(data, el.value);
            applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
            bindFavorites(data);
            writeUrlState({ sort: el.value });
        });
    }

    /* ------ facets (Status / Owner / Quality) ------ */
    function uniqueValues(components, key) {
        var seen = {};
        var out = [];
        for (var i = 0; i < components.length; i++) {
            var v = (components[i][key] || "").trim();
            if (v && !seen[v]) { seen[v] = true; out.push(v); }
        }
        return out.sort();
    }

    function selectFacet(id, label, values) {
        var html = '<label class="pcl-facet"><span class="pcl-facet__label">' + esc(label) + '</span>';
        html += '<select class="pcl-facet__select" id="' + id + '"><option value="">All</option>';
        for (var i = 0; i < values.length; i++) {
            html += '<option value="' + esc(values[i]) + '">' + esc(values[i]) + "</option>";
        }
        return html + "</select></label>";
    }

    function renderFacets(components) {
        var container = document.getElementById("pcl-facets");
        if (!container) return;
        var html = selectFacet("pcl-facet-status", "Status", uniqueValues(components, "status"));
        html += selectFacet("pcl-facet-owner", "Owner", uniqueValues(components, "owner"));
        {{#if features.qualityScore}}
        html += '<label class="pcl-facet"><span class="pcl-facet__label">Quality</span>' +
            '<select class="pcl-facet__select" id="pcl-facet-quality">' +
            '<option value="">Any</option><option value="high">Ready (≥70)</option><option value="low">Needs work (&lt;70)</option>' +
            "</select></label>";
        {{/if}}
        html += '<button type="button" class="pcl-facet__reset" id="pcl-facet-reset">Reset</button>';
        container.innerHTML = html;
    }

    function getFacetState() {
        function val(id) { var el = document.getElementById(id); return el ? el.value : ""; }
        return { status: val("pcl-facet-status"), owner: val("pcl-facet-owner"), quality: val("pcl-facet-quality") };
    }

    function bindFacets(searchInput) {
        var container = document.getElementById("pcl-facets");
        if (!container) return;
        container.addEventListener("change", function () {
            applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
        });
        var reset = document.getElementById("pcl-facet-reset");
        if (reset) {
            reset.addEventListener("click", function () {
                ["pcl-facet-status", "pcl-facet-owner", "pcl-facet-quality"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = "";
                });
                applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
            });
        }
    }

    {{#if features.qualityScore}}
    /* ------ quality dashboard strip ------ */
    function renderMetrics(data) {
        var container = document.getElementById("pcl-metrics");
        if (!container) return;
        var comps = data.components || [];
        var total = comps.length || 1;
        var sumQuality = 0, documented = 0, governed = 0, dialogs = 0;
        for (var i = 0; i < comps.length; i++) {
            sumQuality += (comps[i].qualityScore || 0);
            if (comps[i].readmePath) documented++;
            if (comps[i].owner && comps[i].status && comps[i].version) governed++;
            if (comps[i].hasDialog) dialogs++;
        }
        var chips = [
            metricChip(Math.round(sumQuality / total) + "/100", "Avg quality"),
            metricChip(pct(documented, total), "Documented"),
            metricChip(pct(governed, total), "Governed"),
            metricChip(pct(dialogs, total), "Authorable")
        ];
        container.innerHTML = chips.join("");
    }
    function metricChip(value, label) {
        return '<div class="pcl-metric"><span class="pcl-metric__value">' + esc(value) +
            '</span><span class="pcl-metric__label">' + esc(label) + "</span></div>";
    }
    function pct(n, total) { return Math.round((n / total) * 100) + "%"; }
    {{else}}
    function renderMetrics() {}
    {{/if}}

    function getActiveFilter() {
        var active = document.querySelector(".pcl-pill.pcl-pill--active:not(.pcl-pill--fav)");
        return active ? (active.getAttribute("data-filter") || "") : "";
    }

    function bindPills(searchInput) {
        var pills = document.querySelectorAll(".pcl-pill");
        pills.forEach(function (pill) {
            pill.addEventListener("click", function () {
                var filter = pill.getAttribute("data-filter") || "";
                if (filter === "__favorites__") {
                    pill.classList.toggle("pcl-pill--active");
                    _searchState.showFavOnly = pill.classList.contains("pcl-pill--active");
                    writeUrlState({ favorites: _searchState.showFavOnly });
                    applyFilters(searchInput ? searchInput.value : "", getActiveFilter(), getFacetState());
                    return;
                }
                pills.forEach(function (p) { if (!p.classList.contains("pcl-pill--fav")) p.classList.remove("pcl-pill--active"); });
                pill.classList.add("pcl-pill--active");
                writeUrlState({ category: filter });
                var query = searchInput ? searchInput.value : "";
                applyFilters(query, filter, getFacetState());
            });
        });
    }

    var _searchState = { needle: "", scope: "all", showFavOnly: false };

    function applyFilters(query, category, facets) {
        query = (query || "").trim();
        facets = facets || {};
        var scope = _searchState.scope;
        var favOnly = _searchState.showFavOnly;
        var cards = document.querySelectorAll(".pcl-card");
        var subSections = document.querySelectorAll(".pcl-subcategory-section");
        var sections = document.querySelectorAll(".pcl-category-section");
        var visibleCount = 0;
        cards.forEach(function (card) {
            var cat = card.getAttribute("data-category") || "";
            var fieldsVal = (card.getAttribute("data-fields") || "").trim();
            var hay;
            if (scope === "fields") {
                if (!fieldsVal) { card.style.display = "none"; return; }
                hay = fieldsVal;
            } else {
                hay = (card.getAttribute("data-title") || "") + " " + (card.getAttribute("data-desc") || "") + " " +
                    (card.getAttribute("data-group") || "") + " " + cat + " " + (card.getAttribute("data-subcategory") || "") + " " +
                    fieldsVal + " " + (card.getAttribute("data-tags") || "") + " " + (card.getAttribute("data-owner") || "");
            }
            var score = fuzzyScore(query, hay);
            var matchCategory = !category || cat === category;
            var matchFav = !favOnly || isFavorite(card.getAttribute("data-name") || "");
            var matchStatus = !facets.status || (card.getAttribute("data-status") || "") === facets.status;
            var matchOwner = !facets.owner || (card.getAttribute("data-owner") || "") === facets.owner;
            var quality = parseInt(card.getAttribute("data-quality") || "0", 10);
            var matchQuality = !facets.quality || (facets.quality === "high" ? quality >= 70 : quality < 70);
            var show = score > 0 && matchCategory && matchFav && matchStatus && matchOwner && matchQuality;
            card.style.display = show ? "" : "none";
            card.setAttribute("data-score", score);
            var titleEl = card.querySelector(".pcl-card__title");
            if (titleEl) {
                var origTitle = card.getAttribute("data-title") || "";
                if (query && query.length >= 2 && show) { titleEl.innerHTML = highlightText(origTitle, query); }
                else { titleEl.textContent = origTitle; }
            }
            if (show) visibleCount++;
        });
        subSections.forEach(function (sub) {
            var vis = sub.querySelectorAll('.pcl-card:not([style*="display: none"])');
            sub.style.display = vis.length > 0 ? "" : "none";
        });
        sections.forEach(function (section) {
            var vis = section.querySelectorAll('.pcl-card:not([style*="display: none"])');
            section.style.display = vis.length > 0 ? "" : "none";
        });
        var empty = document.querySelector(".pcl-empty");
        if (empty) empty.style.display = visibleCount === 0 ? "" : "none";
        var resultsBar = document.getElementById("pcl-results-bar");
        var filteredEl = document.getElementById("pcl-filtered-count");
        var isFiltered = query || scope !== "all" || favOnly || category;
        if (resultsBar) resultsBar.style.display = isFiltered ? "" : "none";
        if (filteredEl && isFiltered) filteredEl.textContent = visibleCount;
    }

    /* ====================================================
       DETAIL VIEW
       ==================================================== */

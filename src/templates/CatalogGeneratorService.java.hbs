package {{package}};

import java.io.ByteArrayInputStream;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Calendar;
import java.util.Collections;
import java.util.Date;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;

import javax.jcr.Binary;
import javax.jcr.Node;
import javax.jcr.Session;

import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.apache.sling.commons.scheduler.ScheduleOptions;
import org.apache.sling.commons.scheduler.Scheduler;
import org.apache.sling.settings.SlingSettingsService;
import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.google.gson.Gson;

/**
 * Generates a static component catalog JSON in DAM so the servlet can serve it
 * without needing jcr:read on /apps at request time.
 *
 * On bundle activation, schedules a one-shot job 10 minutes out so all bundles
 * and services have time to resolve. Also runs on a daily schedule to keep the
 * JSON fresh.
 *
 * If /apps is not readable (ACL issue on AEMaaCS), the job silently skips and
 * leaves any existing DAM JSON untouched — stale data is better than no data.
 *
 * Generated by AEM Component Catalog.
 */
@Component(
        service = { CatalogGeneratorService.class, Runnable.class },
        immediate = true,
        property = {
                "scheduler.expression={{generatorCron}}",
                "scheduler.concurrent:Boolean=false",
                "scheduler.runOn=SINGLE"
        }
)
public final class CatalogGeneratorService implements Runnable {

    private static final Logger LOG = LoggerFactory.getLogger(CatalogGeneratorService.class);
    private static final Gson GSON = new Gson();
    private static final String SUBSERVICE_NAME = {{javaString subServiceName}};
    private static final String COMPONENTS_ROOT = {{javaString componentRoot}};
    private static final String STATIC_CATALOG_DAM_PATH = {{javaString staticCatalogDamPath}};
    private static final String STATIC_CATALOG_CONTENT_PATH = {{javaString staticCatalogContentPath}};
    private static final long STARTUP_DELAY_MS = 10L * 60L * 1000L;
    private static final SimpleDateFormat DATE_FMT = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss z");

    private static final Map<String, String> CATEGORY_LABELS = new HashMap<>();
    private static final Set<String> EXCLUDED_GROUPS = new HashSet<>();
    private static final Set<String> EXCLUDED_LEAF_NAMES = new HashSet<>();
    private static final List<String> EXCLUDED_SUPER_TOKENS = new ArrayList<>();

    static {
        {{#each excludedGroups}}
        EXCLUDED_GROUPS.add({{javaString this}});
        {{/each}}
        {{#each excludedLeafNames}}
        EXCLUDED_LEAF_NAMES.add({{javaString this}});
        {{/each}}
        {{#each excludedSuperTypeTokens}}
        EXCLUDED_SUPER_TOKENS.add({{javaString this}});
        {{/each}}
        {{#each categoryLabels}}
        CATEGORY_LABELS.put({{javaString key}}, {{javaString label}});
        {{/each}}
    }

    @Reference
    private transient ResourceResolverFactory resolverFactory;

    @Reference
    private transient SlingSettingsService slingSettings;

    @Reference
    private transient Scheduler scheduler;

    @Activate
    protected void activate() {
        long now = System.currentTimeMillis();
        long fireAtMs = now + STARTUP_DELAY_MS;
        Date fireAt = new Date(fireAtMs);
        String nowStr;
        String fireAtStr;
        synchronized (DATE_FMT) {
            nowStr = DATE_FMT.format(new Date(now));
            fireAtStr = DATE_FMT.format(fireAt);
        }
        LOG.info("[CatalogGenerator] Service ACTIVATED at {}; runModes={}", nowStr, slingSettings.getRunModes());
        LOG.info("[CatalogGenerator] Scheduling one-shot catalog generation: fireAt={} (currentTime + {}ms)",
                fireAtStr, STARTUP_DELAY_MS);
        LOG.info("[CatalogGenerator] Target DAM path: {}", STATIC_CATALOG_DAM_PATH);
        LOG.info("[CatalogGenerator] Component scan root: {}", COMPONENTS_ROOT);
        try {
            ScheduleOptions options = scheduler.AT(fireAt);
            options.name("catalog-generator-startup");
            options.canRunConcurrently(false);
            scheduler.schedule(this, options);
            LOG.info("[CatalogGenerator] One-shot job scheduled successfully");
        } catch (Exception e) {
            LOG.info("[CatalogGenerator] Could not schedule one-shot job; daily schedule still active: {}",
                    e.getMessage());
        }
    }

    @Override
    public void run() {
        LOG.info("[CatalogGenerator] Job triggered — starting catalog JSON generation");
        Set<String> runModes = slingSettings.getRunModes();
        LOG.info("[CatalogGenerator] Current runModes={}", runModes);
        if (!runModes.contains("author")) {
            LOG.info("[CatalogGenerator] Not an author instance; skipping quietly");
            return;
        }

        Map<String, Object> authentication = Collections.<String, Object>singletonMap(
                ResourceResolverFactory.SUBSERVICE, SUBSERVICE_NAME);
        try (ResourceResolver resolver = resolverFactory.getServiceResourceResolver(authentication)) {
            LOG.info("[CatalogGenerator] Service resolver obtained; userId={}", resolver.getUserID());

            Resource root = resolver.getResource(COMPONENTS_ROOT);
            if (root == null) {
                LOG.info("[CatalogGenerator] Root path {} not visible to service user; " +
                        "skipping generation, existing DAM JSON (if any) stays untouched", COMPONENTS_ROOT);
                return;
            }

            boolean hasChildren = root.listChildren().hasNext();
            if (!hasChildren) {
                LOG.info("[CatalogGenerator] Root path {} visible but children are NOT readable " +
                        "(principal-based ACL cascade issue); skipping generation, " +
                        "existing DAM JSON stays untouched", COMPONENTS_ROOT);
                return;
            }

            int directChildCount = 0;
            for (Resource child : root.getChildren()) {
                directChildCount++;
            }
            LOG.info("[CatalogGenerator] Root has {} direct children; proceeding with scan", directChildCount);

            List<Map<String, Object>> components = new ArrayList<>();
            Map<String, Integer> groups = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
            collectComponents(root, components, groups);

            if (components.isEmpty()) {
                LOG.info("[CatalogGenerator] Scan returned 0 components (all filtered?); " +
                        "skipping DAM write to preserve existing data");
                return;
            }

            components.sort((a, b) -> String.valueOf(a.get("title"))
                    .compareToIgnoreCase(String.valueOf(b.get("title"))));

            Map<String, Integer> categories = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
            int totalScore = 0;
            for (Map<String, Object> c : components) {
                totalScore += ((Number) c.getOrDefault("qualityScore", 0)).intValue();
                categories.merge(String.valueOf(c.get("category")), 1, Integer::sum);
            }
            int avgScore = components.isEmpty() ? 0 : Math.round((float) totalScore / components.size());

            Map<String, Object> catalog = new LinkedHashMap<>();
            catalog.put("total", components.size());
            catalog.put("groups", groups);
            catalog.put("categories", categories);
            catalog.put("components", components);
            catalog.put("offset", 0);
            catalog.put("limit", components.size());
            catalog.put("hasMore", false);
            catalog.put("averageQualityScore", avgScore);
            catalog.put("generatedAt", System.currentTimeMillis());

            String json = GSON.toJson(catalog);
            byte[] bytes = json.getBytes(StandardCharsets.UTF_8);

            LOG.info("[CatalogGenerator] Catalog built: {} components, {} groups, {} categories, {} bytes",
                    components.size(), groups.size(), categories.size(), bytes.length);

            boolean written = writeJsonToDam(resolver, bytes);
            if (!written) {
                written = writeJsonToContent(resolver, json);
            }
            if (written) {
                LOG.info("[CatalogGenerator] Catalog JSON persisted successfully");
            } else {
                LOG.info("[CatalogGenerator] Could not write catalog JSON to DAM or /content; " +
                        "existing data (if any) stays untouched");
            }

        } catch (LoginException e) {
            LOG.info("[CatalogGenerator] Cannot obtain service resolver ({}); " +
                    "skipping generation, existing DAM JSON stays untouched", e.getMessage());
        } catch (Exception e) {
            LOG.info("[CatalogGenerator] Generation failed ({}); " +
                    "existing DAM JSON stays untouched", e.getMessage());
            LOG.debug("[CatalogGenerator] Full stack trace for generation failure", e);
        }
    }

    private boolean writeJsonToDam(ResourceResolver resolver, byte[] bytes) {
        try {
            Session session = resolver.adaptTo(Session.class);
            if (session == null) {
                LOG.info("[CatalogGenerator] Cannot adapt resolver to JCR Session");
                return false;
            }

            String parentPath = STATIC_CATALOG_DAM_PATH.substring(0, STATIC_CATALOG_DAM_PATH.lastIndexOf('/'));
            if (!session.nodeExists(parentPath)) {
                LOG.info("[CatalogGenerator] DAM parent path {} does not exist; skipping DAM write", parentPath);
                return false;
            }

            Node damNode;
            if (session.nodeExists(STATIC_CATALOG_DAM_PATH)) {
                damNode = session.getNode(STATIC_CATALOG_DAM_PATH);
            } else {
                Node parent = session.getNode(parentPath);
                String fileName = STATIC_CATALOG_DAM_PATH.substring(STATIC_CATALOG_DAM_PATH.lastIndexOf('/') + 1);
                damNode = parent.addNode(fileName, "nt:file");
            }

            Node contentNode;
            if (damNode.hasNode("jcr:content")) {
                contentNode = damNode.getNode("jcr:content");
            } else {
                contentNode = damNode.addNode("jcr:content", "nt:resource");
            }

            Binary binary = session.getValueFactory().createBinary(new ByteArrayInputStream(bytes));
            contentNode.setProperty("jcr:data", binary);
            contentNode.setProperty("jcr:mimeType", "application/json");
            contentNode.setProperty("jcr:lastModified", Calendar.getInstance());
            session.save();
            LOG.info("[CatalogGenerator] DAM JSON written: {}", STATIC_CATALOG_DAM_PATH);
            return true;
        } catch (Exception e) {
            LOG.info("[CatalogGenerator] DAM write failed ({}); trying /content fallback", e.getMessage());
            LOG.debug("[CatalogGenerator] DAM write stack trace", e);
            try {
                Session session = resolver.adaptTo(Session.class);
                if (session != null && session.hasPendingChanges()) {
                    session.refresh(false);
                }
            } catch (Exception ignored) { }
            return false;
        }
    }

    private boolean writeJsonToContent(ResourceResolver resolver, String json) {
        try {
            Session session = resolver.adaptTo(Session.class);
            if (session == null) return false;

            Node dataNode;
            if (session.nodeExists(STATIC_CATALOG_CONTENT_PATH)) {
                dataNode = session.getNode(STATIC_CATALOG_CONTENT_PATH);
            } else {
                String parentPath = STATIC_CATALOG_CONTENT_PATH.substring(0, STATIC_CATALOG_CONTENT_PATH.lastIndexOf('/'));
                if (!session.nodeExists(parentPath)) {
                    LOG.info("[CatalogGenerator] Content parent path {} does not exist", parentPath);
                    return false;
                }
                Node parent = session.getNode(parentPath);
                String nodeName = STATIC_CATALOG_CONTENT_PATH.substring(STATIC_CATALOG_CONTENT_PATH.lastIndexOf('/') + 1);
                dataNode = parent.addNode(nodeName, "nt:unstructured");
            }

            dataNode.setProperty("catalogJson", json);
            dataNode.setProperty("jcr:lastModified", Calendar.getInstance());
            session.save();
            LOG.info("[CatalogGenerator] Content JSON written: {}", STATIC_CATALOG_CONTENT_PATH);
            return true;
        } catch (Exception e) {
            LOG.info("[CatalogGenerator] Content write also failed ({})", e.getMessage());
            LOG.debug("[CatalogGenerator] Content write stack trace", e);
            try {
                Session session = resolver.adaptTo(Session.class);
                if (session != null && session.hasPendingChanges()) {
                    session.refresh(false);
                }
            } catch (Exception ignored) { }
            return false;
        }
    }

    private void collectComponents(Resource parent, List<Map<String, Object>> components,
                                   Map<String, Integer> groups) {
        Iterator<Resource> children = parent.listChildren();
        while (children.hasNext()) {
            Resource resource = children.next();
            ValueMap props = resource.getValueMap();
            if ("cq:Component".equals(props.get("jcr:primaryType", String.class))) {
                addComponent(resource, props, components, groups);
            }
            collectComponents(resource, components, groups);
        }
    }

    private boolean isStructural(String name, String superType) {
        if (name != null && EXCLUDED_LEAF_NAMES.contains(name.toLowerCase())) return true;
        if (superType != null && !superType.isEmpty()) {
            String needle = superType.toLowerCase();
            for (String token : EXCLUDED_SUPER_TOKENS) {
                if (needle.contains(token)) return true;
            }
        }
        return false;
    }

    private String prettifyCategory(String key) {
        if (key == null || key.isEmpty()) return "General";
        return Character.toUpperCase(key.charAt(0)) + key.substring(1);
    }

    private void addComponent(Resource resource, ValueMap properties,
                              List<Map<String, Object>> components,
                              Map<String, Integer> groups) {
        String group = properties.get("componentGroup", String.class);
        if (group == null || EXCLUDED_GROUPS.contains(group)) return;

        String superType = properties.get("sling:resourceSuperType", String.class);
        if (isStructural(resource.getName(), superType)) return;

        String relativeName = resource.getPath().substring(COMPONENTS_ROOT.length() + 1);
        String resourceType = resource.getPath().replaceFirst("^/apps/", "");

        boolean hasDialog = resource.getChild("_cq_dialog") != null || resource.getChild("cq:dialog") != null;
        boolean hasEditConfig = resource.getChild("_cq_editConfig") != null || resource.getChild("cq:editConfig") != null;
        boolean hasDesignDialog = resource.getChild("_cq_design_dialog") != null || resource.getChild("cq:design_dialog") != null;
        boolean hasReadme = resource.getChild("README.md") != null;

        String owner = properties.get({{javaString ownerProperty}}, "");
        String status = properties.get({{javaString statusProperty}}, "");
        String version = properties.get({{javaString versionProperty}}, "");
        String subCat = properties.get({{javaString subCategoryProperty}}, "");

        List<String> missing = new ArrayList<>();
        int score = 0;
        if (hasDialog) score += 25; else missing.add("author dialog");
        if (hasReadme) score += 20; else missing.add("README documentation");
        missing.add("thumbnail");
        if (!owner.isEmpty()) score += 15; else missing.add("owner");
        if (!status.isEmpty()) score += 15; else missing.add("lifecycle status");
        if (!version.isEmpty()) score += 10; else missing.add("version");

        int firstSlash = relativeName.indexOf('/');
        String categoryKey = firstSlash > 0 ? relativeName.substring(0, firstSlash) : "";
        String category = CATEGORY_LABELS.getOrDefault(categoryKey, prettifyCategory(categoryKey));
        String subCategory = !subCat.isEmpty() ? subCat : group;

        Map<String, Object> component = new LinkedHashMap<>();
        component.put("name", relativeName);
        component.put("title", properties.get("jcr:title", resource.getName()));
        component.put("description", properties.get("jcr:description", ""));
        component.put("group", group);
        component.put("category", category);
        component.put("categoryKey", categoryKey);
        component.put("subCategory", subCategory);
        component.put("resourceType", resourceType);
        component.put("superType", superType != null ? superType : "");
        component.put("isContainer", properties.get("cq:isContainer", false));
        component.put("path", resource.getPath());
        component.put("hasDialog", hasDialog);
        component.put("hasEditConfig", hasEditConfig);
        component.put("hasDesignDialog", hasDesignDialog);
        component.put("owner", owner);
        component.put("status", status);
        component.put("version", version);
        component.put("usageCount", 0);
        component.put("tags", Collections.emptyList());
        component.put("qualityScore", score);
        component.put("qualityMissing", missing);
        if (hasReadme) component.put("readmePath", resource.getPath() + "/README.md");

        components.add(component);
        groups.merge(group, 1, Integer::sum);
    }
}

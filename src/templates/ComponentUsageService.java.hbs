package {{package}};

import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

import javax.jcr.query.Query;

import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * In-memory index of which content pages use each component, rebuilt on a nightly
 * schedule. Registered as a Sling scheduler job via the {@code scheduler.expression}
 * property so the crawl runs once per night (author only); the catalog servlet then
 * reads the cached counts and page lists without querying per request.
 *
 * Generated by AEM Component Catalog Enterprise.
 */
@Component(
        service = { ComponentUsageService.class, Runnable.class },
        immediate = true,
        property = {
                "scheduler.expression={{usageCron}}",
                "scheduler.concurrent:Boolean=false",
                "scheduler.runOn=SINGLE"
        }
)
public final class ComponentUsageService implements Runnable {

    private static final Logger LOG = LoggerFactory.getLogger(ComponentUsageService.class);
    private static final String SUBSERVICE_NAME = {{javaString subServiceName}};
    private static final String COMPONENTS_ROOT = {{javaString componentRoot}};
    private static final String CATALOG_CONTENT_ROOT = {{javaString catalogContentRoot}};
    private static final String SEGMENT = "/components/";

    @Reference
    private transient ResourceResolverFactory resolverFactory;

    private volatile Map<String, List<Map<String, String>>> usageByComponent = Collections.emptyMap();
    private volatile long builtAt = 0L;

    @Activate
    protected void activate() {
        try {
            run();
        } catch (RuntimeException e) {
            LOG.warn("Initial component-usage index build failed; will retry on schedule", e);
        }
    }

    @Override
    public void run() {
        rebuild();
    }

    /** Pages using the given component (by its path relative to the components root). */
    public List<Map<String, String>> pagesFor(String componentName) {
        return usageByComponent.getOrDefault(componentName, Collections.<Map<String, String>>emptyList());
    }

    public int countFor(String componentName) {
        return pagesFor(componentName).size();
    }

    public long builtAt() {
        return builtAt;
    }

    private void rebuild() {
        Map<String, Object> auth = Collections.<String, Object>singletonMap(
                ResourceResolverFactory.SUBSERVICE, SUBSERVICE_NAME);
        try (ResourceResolver resolver = resolverFactory.getServiceResourceResolver(auth)) {
            Set<String> componentNames = collectComponentNames(resolver);
            Map<String, LinkedHashMap<String, Map<String, String>>> accumulator =
                    new HashMap<String, LinkedHashMap<String, Map<String, String>>>();

            String statement = "SELECT n.[jcr:path] FROM [nt:base] AS n "
                    + "WHERE ISDESCENDANTNODE(n, '/content') AND n.[sling:resourceType] LIKE '%" + SEGMENT + "%'";
            Iterator<Resource> hits = resolver.findResources(statement, Query.JCR_SQL2);
            while (hits.hasNext()) {
                Resource resource = hits.next();
                String resourceType = resource.getValueMap().get("sling:resourceType", String.class);
                if (resourceType == null) {
                    continue;
                }
                int index = resourceType.indexOf(SEGMENT);
                if (index < 0) {
                    continue;
                }
                // Maps a direct usage or a site proxy (…/components/<rel>) to the library component.
                String componentName = resourceType.substring(index + SEGMENT.length());
                if (!componentNames.contains(componentName)) {
                    continue;
                }
                Resource page = pageOf(resource);
                if (page == null) {
                    continue;
                }
                String pagePath = page.getPath();
                if (isExcluded(pagePath)) {
                    continue;
                }
                accumulator
                        .computeIfAbsent(componentName, k -> new LinkedHashMap<String, Map<String, String>>())
                        .putIfAbsent(pagePath, pageInfo(page));
            }

            Map<String, List<Map<String, String>>> next = new HashMap<String, List<Map<String, String>>>();
            for (Map.Entry<String, LinkedHashMap<String, Map<String, String>>> entry : accumulator.entrySet()) {
                next.put(entry.getKey(), new ArrayList<Map<String, String>>(entry.getValue().values()));
            }
            usageByComponent = next;
            builtAt = System.currentTimeMillis();
            LOG.info("Component usage index rebuilt: {} components in use across /content", next.size());
        } catch (LoginException e) {
            LOG.error("Component usage index: unable to obtain the service resolver", e);
        } catch (RuntimeException e) {
            LOG.error("Component usage index build failed", e);
        }
    }

    private Set<String> collectComponentNames(ResourceResolver resolver) {
        Set<String> names = new HashSet<String>();
        Resource root = resolver.getResource(COMPONENTS_ROOT);
        if (root != null) {
            collectComponentNames(root, names);
        }
        return names;
    }

    private void collectComponentNames(Resource parent, Set<String> names) {
        for (Resource child : parent.getChildren()) {
            if ("cq:Component".equals(child.getValueMap().get("jcr:primaryType", String.class))) {
                names.add(child.getPath().substring(COMPONENTS_ROOT.length() + 1));
            }
            collectComponentNames(child, names);
        }
    }

    private Resource pageOf(Resource resource) {
        Resource current = resource;
        while (current != null) {
            if ("cq:Page".equals(current.getValueMap().get("jcr:primaryType", String.class))) {
                return current;
            }
            current = current.getParent();
        }
        return null;
    }

    private Map<String, String> pageInfo(Resource page) {
        Map<String, String> info = new LinkedHashMap<String, String>();
        info.put("path", page.getPath());
        String title = page.getName();
        Resource content = page.getChild("jcr:content");
        if (content != null) {
            title = content.getValueMap().get("jcr:title", title);
        }
        info.put("title", title);
        return info;
    }

    private boolean isExcluded(String pagePath) {
        return pagePath.equals(CATALOG_CONTENT_ROOT)
                || pagePath.startsWith(CATALOG_CONTENT_ROOT + "/")
                || pagePath.startsWith("/content/dam/");
    }
}

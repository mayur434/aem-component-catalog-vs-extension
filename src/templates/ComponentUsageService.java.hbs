package {{package}};

import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

import javax.jcr.query.Query;

import com.day.cq.replication.ReplicationStatus;

import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.apache.sling.settings.SlingSettingsService;
import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * In-memory index of which live content pages use each component, rebuilt on a nightly
 * schedule. Registered as a Sling scheduler job via the {@code scheduler.expression}
 * property so the crawl runs once per night; the catalog servlet reads the cached counts and
 * page lists from this same instance without querying per request.
 *
 * <p>Runs on both tiers, and "live" is evaluated per tier - see {@link #isPublished}. On
 * author, replication status decides; on publish, presence in the repository is itself the
 * published state. Counting is therefore correct on whichever instance this bundle runs.
 *
 * Generated by AEM Component Catalog.
 */
@Component(
        service = { ComponentUsageService.class, Runnable.class },
        immediate = true,
        property = {
                "scheduler.expression={{usageCron}}",
                "scheduler.concurrent:Boolean=false",
                "scheduler.runOn=SINGLE"
        }
)
public final class ComponentUsageService implements Runnable {

    private static final Logger LOG = LoggerFactory.getLogger(ComponentUsageService.class);
    private static final String SUBSERVICE_NAME = {{javaString subServiceName}};
    private static final String COMPONENTS_ROOT = {{javaString componentRoot}};
    private static final String CATALOG_CONTENT_ROOT = {{javaString catalogContentRoot}};
    private static final String SEGMENT = "/components/";

    @Reference
    private transient ResourceResolverFactory resolverFactory;

    @Reference
    private transient SlingSettingsService slingSettings;

    private volatile Map<String, List<Map<String, String>>> usageByComponent = Collections.emptyMap();
    private volatile long builtAt = 0L;

    @Activate
    protected void activate() {
        try {
            run();
        } catch (RuntimeException e) {
            LOG.warn("Initial component-usage index build failed; will retry on schedule", e);
        }
    }

    @Override
    public void run() {
        rebuild();
    }

    /** Pages using the given component (by its path relative to the components root). */
    public List<Map<String, String>> pagesFor(String componentName) {
        return usageByComponent.getOrDefault(componentName, Collections.<Map<String, String>>emptyList());
    }

    public int countFor(String componentName) {
        return pagesFor(componentName).size();
    }

    public long builtAt() {
        return builtAt;
    }

    /**
     * Whether this instance has any usage data at all, i.e. at least one component was found
     * in use somewhere. Distinguishes "this component happens to be unused" from "this
     * environment has no usage information", which are very different situations: the first
     * is a real signal worth filtering on, the second just means nothing is live here yet
     * (a fresh environment, or content that was never activated). Callers must not filter
     * components out on the strength of an index that found nothing at all - that yields an
     * empty catalog rather than an unfiltered one.
     */
    public boolean hasUsageData() {
        return !usageByComponent.isEmpty();
    }

    private void rebuild() {
        Map<String, Object> auth = Collections.<String, Object>singletonMap(
                ResourceResolverFactory.SUBSERVICE, SUBSERVICE_NAME);
        try (ResourceResolver resolver = resolverFactory.getServiceResourceResolver(auth)) {
            Set<String> componentNames = collectComponentNames(resolver);
            if (componentNames.isEmpty()) {
                LOG.warn("No library components found under {}; the service user may lack jcr:read on /apps",
                        COMPONENTS_ROOT);
            } else {
                LOG.info("Found {} library component definitions under {}", componentNames.size(), COMPONENTS_ROOT);
            }
            Map<String, LinkedHashMap<String, Map<String, String>>> accumulator =
                    new HashMap<String, LinkedHashMap<String, Map<String, String>>>();
            // resourceType -> library component rel (or null), memoised so each proxy is resolved once.
            Map<String, String> relCache = new HashMap<String, String>();

            String statement = "SELECT n.[jcr:path] FROM [nt:base] AS n "
                    + "WHERE ISDESCENDANTNODE(n, '/content') AND n.[sling:resourceType] LIKE '%" + SEGMENT + "%'";
            Iterator<Resource> hits = resolver.findResources(statement, Query.JCR_SQL2);
            int hitCount = 0;
            int matchedCount = 0;
            int unpublishedCount = 0;
            while (hits.hasNext()) {
                Resource resource = hits.next();
                hitCount++;
                String resourceType = resource.getValueMap().get("sling:resourceType", String.class);
                if (resourceType == null) {
                    continue;
                }
                // Sites author project-local proxies whose sling:resourceSuperType points at the
                // library component; resolve the type (direct hit or one-level proxy) to that library rel.
                String componentName = libraryRelFor(resolver, resourceType, componentNames, relCache);
                if (componentName == null) {
                    continue;
                }
                matchedCount++;
                Resource page = pageOf(resource);
                if (page == null) {
                    continue;
                }
                String pagePath = page.getPath();
                if (isExcluded(pagePath)) {
                    continue;
                }
                if (!isPublished(page)) {
                    unpublishedCount++;
                    continue;
                }
                accumulator
                        .computeIfAbsent(componentName, k -> new LinkedHashMap<String, Map<String, String>>())
                        .putIfAbsent(pagePath, pageInfo(page));
            }

            Map<String, List<Map<String, String>>> next = new HashMap<String, List<Map<String, String>>>();
            for (Map.Entry<String, LinkedHashMap<String, Map<String, String>>> entry : accumulator.entrySet()) {
                next.put(entry.getKey(), new ArrayList<Map<String, String>>(entry.getValue().values()));
            }
            usageByComponent = next;
            builtAt = System.currentTimeMillis();
            LOG.info("Component usage index rebuilt: {} components in use across /content"
                    + " (query hits={}, matched library={}, filtered unpublished={})",
                    next.size(), hitCount, matchedCount, unpublishedCount);
        } catch (LoginException e) {
            LOG.error("Component usage index: unable to obtain the service resolver", e);
        } catch (RuntimeException e) {
            LOG.error("Component usage index build failed", e);
        }
    }

    private Set<String> collectComponentNames(ResourceResolver resolver) {
        Set<String> names = new HashSet<String>();
        Resource root = resolver.getResource(COMPONENTS_ROOT);
        if (root != null) {
            collectComponentNames(root, names);
        }
        return names;
    }

    private void collectComponentNames(Resource parent, Set<String> names) {
        for (Resource child : parent.getChildren()) {
            if ("cq:Component".equals(child.getValueMap().get("jcr:primaryType", String.class))) {
                names.add(child.getPath().substring(COMPONENTS_ROOT.length() + 1));
            }
            collectComponentNames(child, names);
        }
    }

    /**
     * Resolves a page's {@code sling:resourceType} to the library component it renders, either
     * directly or through a single level of site-proxy indirection (the proxy's
     * {@code sling:resourceSuperType} points into the library). Returns the library rel path, or
     * {@code null} when the type is unrelated to the catalog. Results are memoised per resolver run.
     */
    private String libraryRelFor(ResourceResolver resolver, String resourceType,
            Set<String> componentNames, Map<String, String> cache) {
        if (cache.containsKey(resourceType)) {
            return cache.get(resourceType);
        }
        String rel = computeLibraryRel(resolver, resourceType, componentNames);
        cache.put(resourceType, rel);
        return rel;
    }

    private String computeLibraryRel(ResourceResolver resolver, String resourceType,
            Set<String> componentNames) {
        // 1) Direct: the resource type already is a library component.
        String direct = relUnderComponentsRoot(toAbsoluteType(resourceType));
        if (direct != null && componentNames.contains(direct)) {
            return direct;
        }
        // 2) One-level proxy: the site component supers a library component.
        Resource component = resolveType(resolver, resourceType);
        if (component != null) {
            String superType = component.getValueMap().get("sling:resourceSuperType", String.class);
            String superRel = relUnderComponentsRoot(toAbsoluteType(superType));
            if (superRel != null && componentNames.contains(superRel)) {
                return superRel;
            }
        }
        return null;
    }

    private Resource resolveType(ResourceResolver resolver, String resourceType) {
        if (resourceType == null || resourceType.isEmpty()) {
            return null;
        }
        if (resourceType.charAt(0) == '/') {
            return resolver.getResource(resourceType);
        }
        Resource resource = resolver.getResource("/apps/" + resourceType);
        return resource != null ? resource : resolver.getResource("/libs/" + resourceType);
    }

    private String toAbsoluteType(String resourceType) {
        if (resourceType == null || resourceType.isEmpty()) {
            return null;
        }
        return resourceType.charAt(0) == '/' ? resourceType : "/apps/" + resourceType;
    }

    private String relUnderComponentsRoot(String absoluteType) {
        if (absoluteType == null || !absoluteType.startsWith(COMPONENTS_ROOT + "/")) {
            return null;
        }
        return absoluteType.substring(COMPONENTS_ROOT.length() + 1);
    }

    /**
     * Whether a page counts as "live", which is a genuinely different question per tier:
     *
     * <p>On PUBLISH, the page's presence in this repository IS the published state - it only
     * got here by being replicated. Replication-status properties (cq:lastReplicationAction and
     * friends) are written on AUTHOR at activation time and are not reliably carried onto the
     * replicated copy, so applying that check here would report zero usages for everything.
     *
     * <p>On AUTHOR, presence means nothing - drafts live alongside live pages - so the
     * replication status recorded at activation is the correct signal, read via AEM's standard
     * {@link ReplicationStatus} adaptable rather than the raw property.
     */
    private boolean isPublished(Resource page) {
        Resource content = page.getChild("jcr:content");
        if (content == null) {
            return false;
        }
        if (!slingSettings.getRunModes().contains("author")) {
            return true;
        }
        ReplicationStatus status = content.adaptTo(ReplicationStatus.class);
        return status != null && status.isActivated();
    }

    private Resource pageOf(Resource resource) {
        Resource current = resource;
        while (current != null) {
            if ("cq:Page".equals(current.getValueMap().get("jcr:primaryType", String.class))) {
                return current;
            }
            current = current.getParent();
        }
        return null;
    }

    private Map<String, String> pageInfo(Resource page) {
        Map<String, String> info = new LinkedHashMap<String, String>();
        info.put("path", page.getPath());
        String title = page.getName();
        Resource content = page.getChild("jcr:content");
        if (content != null) {
            title = content.getValueMap().get("jcr:title", title);
        }
        info.put("title", title);
        return info;
    }

    private boolean isExcluded(String pagePath) {
        return pagePath.equals(CATALOG_CONTENT_ROOT)
                || pagePath.startsWith(CATALOG_CONTENT_ROOT + "/")
                || pagePath.startsWith("/content/dam/");
    }
}

{
    "scripts": [
        "create service user {{serviceUserName}} with forced path system/cq:services/{{appId}}",
        "set ACL for {{serviceUserName}}\n    allow jcr:read on /apps restriction(rep:glob,/{{appId}}/components/*)\n    allow jcr:read on /apps restriction(rep:glob,/{{appId}}/clientlibs/*)\nend",
        "create path (sling:OrderedFolder) /content",
        "create path (sling:Folder) /conf",
        "create path (sling:Folder) /conf/{{appId}}",
        "create path (nt:unstructured) /conf/{{appId}}/settings",
        "create path (nt:unstructured) /conf/{{appId}}/settings/wcm",
        "create path (nt:unstructured) /conf/{{appId}}/settings/wcm/templates",
        "create path (cq:Template) /conf/{{appId}}/settings/wcm/templates/component-library-page",
        "create path (cq:PageContent) /conf/{{appId}}/settings/wcm/templates/component-library-page/jcr:content",
        "set properties on /conf/{{appId}}/settings/wcm/templates/component-library-page/jcr:content\n    set jcr:title{String} to \"Component Library Page\"\n    set jcr:description{String} to \"Author-only enterprise component catalog\"\n    set status{String} to enabled\nend"{{#each pagePaths}},
        "create path (cq:Page) {{this.path}}",
        "create path (cq:PageContent) {{this.path}}/jcr:content"{{#if this.target}},
        "set properties on {{this.path}}/jcr:content\n    set sling:resourceType{String} to {{../pageResourceType}}\n    set jcr:title{String} to \"{{osgiString ../pageTitle}}\"\n    set cq:template{String} to /conf/{{../appId}}/settings/wcm/templates/component-library-page\nend"{{/if}}{{/each}}
    ]
}

package {{package}};

import java.util.ArrayList;
import java.util.Collections;
import java.util.Date;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.apache.sling.commons.scheduler.ScheduleOptions;
import org.apache.sling.commons.scheduler.Scheduler;
import org.apache.sling.settings.SlingSettingsService;
import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Groups library components that are structurally identical (see {@link ComponentFingerprint})
 * regardless of which brand folder they live in.
 *
 * <p>Unlike {@link ComponentUsageService}, this only needs to run once per deploy: whether a
 * component duplicates another depends entirely on its definition under {@code /apps}, which can
 * only change via a code deploy — never from day-to-day authoring activity. A nightly rebuild
 * would just recompute the same answer, so this schedules a single one-shot job {@link
 * #STARTUP_DELAY_MS} after bundle activation (giving every component bundle time to install) and
 * runs no further schedule until the next deploy restarts this bundle.
 *
 * <p>{@link ComponentLibraryServlet} reads the cached result via {@link #duplicatesFor} on every
 * request without ever triggering a rescan itself — exactly how it already consumes
 * {@link ComponentUsageService}.
 *
 * Generated by AEM Component Catalog.
 */
@Component(service = { ComponentDuplicateService.class, Runnable.class }, immediate = true)
public final class ComponentDuplicateService implements Runnable {

    private static final Logger LOG = LoggerFactory.getLogger(ComponentDuplicateService.class);
    private static final String SUBSERVICE_NAME = {{javaString subServiceName}};
    private static final String COMPONENTS_ROOT = {{javaString componentRoot}};
    private static final long STARTUP_DELAY_MS = 10L * 60L * 1000L;

    private static final Set<String> EXCLUDED_GROUPS = new HashSet<>();
    private static final Set<String> EXCLUDED_LEAF_NAMES = new HashSet<>();
    private static final List<String> EXCLUDED_SUPER_TOKENS = new ArrayList<>();
    private static final Map<String, String> CATEGORY_LABELS = new HashMap<>();

    static {
        {{#each excludedGroups}}
        EXCLUDED_GROUPS.add({{javaString this}});
        {{/each}}
        {{#each excludedLeafNames}}
        EXCLUDED_LEAF_NAMES.add({{javaString this}});
        {{/each}}
        {{#each excludedSuperTypeTokens}}
        EXCLUDED_SUPER_TOKENS.add({{javaString this}});
        {{/each}}
        {{#each categoryLabels}}
        CATEGORY_LABELS.put({{javaString key}}, {{javaString label}});
        {{/each}}
    }

    @Reference
    private transient ResourceResolverFactory resolverFactory;

    @Reference
    private transient SlingSettingsService slingSettings;

    @Reference
    private transient Scheduler scheduler;

    private volatile Map<String, List<Map<String, String>>> duplicatesByComponent = Collections.emptyMap();
    private volatile long builtAt = 0L;

    @Activate
    protected void activate() {
        if (!slingSettings.getRunModes().contains("author")) {
            LOG.info("[DuplicateDetector] Not an author instance; one-shot job not scheduled");
            return;
        }
        try {
            ScheduleOptions options = scheduler.AT(new Date(System.currentTimeMillis() + STARTUP_DELAY_MS));
            options.name("component-duplicate-detector-startup");
            options.canRunConcurrently(false);
            scheduler.schedule(this, options);
            LOG.info("[DuplicateDetector] One-shot job scheduled {} minutes after deployment",
                    STARTUP_DELAY_MS / 60_000);
        } catch (Exception e) {
            LOG.warn("[DuplicateDetector] Could not schedule one-shot job: {}", e.getMessage());
        }
    }

    @Override
    public void run() {
        LOG.info("[DuplicateDetector] Job triggered — scanning for duplicate components");
        if (!slingSettings.getRunModes().contains("author")) {
            LOG.info("[DuplicateDetector] Not an author instance; skipping quietly");
            return;
        }
        Map<String, Object> authentication = Collections.<String, Object>singletonMap(
                ResourceResolverFactory.SUBSERVICE, SUBSERVICE_NAME);
        try (ResourceResolver resolver = resolverFactory.getServiceResourceResolver(authentication)) {
            Resource root = resolver.getResource(COMPONENTS_ROOT);
            if (root == null) {
                LOG.info("[DuplicateDetector] Root path {} not visible to service user; skipping this run",
                        COMPONENTS_ROOT);
                return;
            }

            Map<String, List<String[]>> byFingerprint = new HashMap<>();
            collectFingerprints(root, byFingerprint);

            Map<String, List<Map<String, String>>> next = new HashMap<>();
            int duplicateGroups = 0;
            for (List<String[]> group : byFingerprint.values()) {
                if (group.size() < 2) {
                    continue;
                }
                duplicateGroups++;
                for (String[] entry : group) {
                    List<Map<String, String>> duplicates = new ArrayList<>();
                    for (String[] other : group) {
                        if (other == entry) {
                            continue;
                        }
                        Map<String, String> summary = new LinkedHashMap<>();
                        summary.put("name", other[0]);
                        summary.put("title", other[1]);
                        summary.put("category", other[2]);
                        summary.put("path", other[3]);
                        duplicates.add(summary);
                    }
                    next.put(entry[0], duplicates);
                }
            }
            duplicatesByComponent = next;
            builtAt = System.currentTimeMillis();
            LOG.info("[DuplicateDetector] Scan complete: {} duplicate group(s) among {} fingerprinted components",
                    duplicateGroups, next.size());
        } catch (LoginException e) {
            LOG.error("[DuplicateDetector] Unable to obtain the service resolver", e);
        } catch (RuntimeException e) {
            LOG.error("[DuplicateDetector] Scan failed", e);
        }
    }

    /** Other components that duplicate the given library-relative component name, or an empty list. */
    public List<Map<String, String>> duplicatesFor(String componentName) {
        return duplicatesByComponent.getOrDefault(componentName, Collections.<Map<String, String>>emptyList());
    }

    public long builtAt() {
        return builtAt;
    }

    private void collectFingerprints(Resource parent, Map<String, List<String[]>> byFingerprint) {
        Iterator<Resource> children = parent.listChildren();
        while (children.hasNext()) {
            Resource resource = children.next();
            ValueMap properties = resource.getValueMap();
            if ("cq:Component".equals(properties.get("jcr:primaryType", String.class))) {
                addIfEligible(resource, properties, byFingerprint);
            }
            collectFingerprints(resource, byFingerprint);
        }
    }

    private void addIfEligible(Resource resource, ValueMap properties, Map<String, List<String[]>> byFingerprint) {
        String group = properties.get("componentGroup", String.class);
        if (group == null || EXCLUDED_GROUPS.contains(group)) {
            return;
        }
        String superType = properties.get("sling:resourceSuperType", String.class);
        if (isStructural(resource.getName(), superType)) {
            return;
        }

        String relativeName = resource.getPath().substring(COMPONENTS_ROOT.length() + 1);
        String title = properties.get("jcr:title", resource.getName());
        int firstSlash = relativeName.indexOf('/');
        String categoryKey = firstSlash > 0 ? relativeName.substring(0, firstSlash) : "";
        String category = CATEGORY_LABELS.getOrDefault(categoryKey, prettifyCategory(categoryKey));

        String fingerprint = ComponentFingerprint.compute(resource);
        String[] entry = { relativeName, title, category, resource.getPath() };
        byFingerprint.computeIfAbsent(fingerprint, k -> new ArrayList<>()).add(entry);
    }

    private boolean isStructural(String name, String superType) {
        if (name != null && EXCLUDED_LEAF_NAMES.contains(name.toLowerCase())) {
            return true;
        }
        if (superType != null && !superType.isEmpty()) {
            String needle = superType.toLowerCase();
            for (String token : EXCLUDED_SUPER_TOKENS) {
                if (needle.contains(token)) {
                    return true;
                }
            }
        }
        return false;
    }

    private String prettifyCategory(String key) {
        if (key == null || key.isEmpty()) {
            return "General";
        }
        return Character.toUpperCase(key.charAt(0)) + key.substring(1);
    }
}

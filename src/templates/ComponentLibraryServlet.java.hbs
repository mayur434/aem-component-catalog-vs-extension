package {{package}};

import java.io.IOException;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;
import java.util.regex.Pattern;

import javax.servlet.Servlet;

import org.apache.sling.api.SlingHttpServletRequest;
import org.apache.sling.api.SlingHttpServletResponse;
import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.apache.sling.api.servlets.SlingSafeMethodsServlet;
import org.apache.sling.api.resource.observation.ResourceChange;
import org.apache.sling.api.resource.observation.ResourceChangeListener;
import org.apache.sling.servlets.annotations.SlingServletResourceTypes;
import org.apache.sling.settings.SlingSettingsService;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.google.gson.Gson;

/**
 * Author-only, cached component metadata endpoint generated by AEM Component Catalog Enterprise.
 */
@Component(
        service = { Servlet.class, ResourceChangeListener.class },
        property = {
                ResourceChangeListener.PATHS + "={{componentRoot}}",
                ResourceChangeListener.PATHS + "={{assetRoot}}"
        }
)
@SlingServletResourceTypes(
        resourceTypes = "{{resourceType}}",
        selectors = "components",
        extensions = "json",
        methods = "GET"
)
public final class ComponentLibraryServlet extends SlingSafeMethodsServlet implements ResourceChangeListener {

    private static final long serialVersionUID = 1L;
    private static final Logger LOG = LoggerFactory.getLogger(ComponentLibraryServlet.class);
    private static final Gson GSON = new Gson();
    private static final String COMPONENTS_ROOT = {{javaString componentRoot}};
    private static final String ASSET_ROOT = {{javaString assetRoot}};
    private static final String SUBSERVICE_NAME = {{javaString subServiceName}};
    private static final String LAYOUT_FOLDER = {{javaString layoutFolderName}};
    private static final String OWNER_PROPERTY = {{javaString ownerProperty}};
    private static final String STATUS_PROPERTY = {{javaString statusProperty}};
    private static final String VERSION_PROPERTY = {{javaString versionProperty}};
    private static final String TAGS_PROPERTY = {{javaString tagsProperty}};
    private static final String SUB_CATEGORY_PROPERTY = {{javaString subCategoryProperty}};
    private static final Map<String, String> CATEGORY_LABELS = new HashMap<>();
    private static final int DEFAULT_PAGE_SIZE = {{pageSize}};
    private static final int MAX_PAGE_SIZE = 1000;
    private static final long CACHE_MILLIS = {{cacheSeconds}}L * 1000L;
    private static final Set<String> EXCLUDED_GROUPS = new HashSet<>();
    private static final List<String> THUMBNAIL_NAMES = new ArrayList<>();
    private static final List<String> LAYOUT_EXCLUDES = new ArrayList<>();

    static {
        {{#each excludedGroups}}
        EXCLUDED_GROUPS.add({{javaString this}});
        {{/each}}
        {{#each thumbnailFileNames}}
        THUMBNAIL_NAMES.add({{javaString this}});
        {{/each}}
        {{#each layoutExclude}}
        LAYOUT_EXCLUDES.add({{javaString this}});
        {{/each}}
        {{#each categoryLabels}}
        CATEGORY_LABELS.put({{javaString key}}, {{javaString label}});
        {{/each}}
    }

    @Reference
    private transient ResourceResolverFactory resolverFactory;

    @Reference
    private transient SlingSettingsService slingSettings;

    private transient volatile CacheEntry cache;

    @Override
    protected void doGet(SlingHttpServletRequest request, SlingHttpServletResponse response) throws IOException {
        secureHeaders(response);
        if (!slingSettings.getRunModes().contains("author")) {
            response.sendError(SlingHttpServletResponse.SC_NOT_FOUND);
            return;
        }

        int offset = boundedInteger(request.getParameter("offset"), 0, 0, Integer.MAX_VALUE);
        int limit = boundedInteger(request.getParameter("limit"), DEFAULT_PAGE_SIZE, 1, MAX_PAGE_SIZE);
        try {
            CatalogData catalog = getCatalog();
            int from = Math.min(offset, catalog.components.size());
            int to = Math.min(from + limit, catalog.components.size());
            Map<String, Object> result = new LinkedHashMap<>();
            result.put("total", catalog.components.size());
            result.put("groups", catalog.groups);
            result.put("categories", catalog.categories);
            result.put("components", catalog.components.subList(from, to));
            result.put("offset", from);
            result.put("limit", limit);
            result.put("hasMore", to < catalog.components.size());
            result.put("averageQualityScore", catalog.averageQualityScore);
            response.getWriter().write(GSON.toJson(result));
        } catch (LoginException e) {
            LOG.error("Unable to obtain the component catalog service resolver", e);
            writeError(response, SlingHttpServletResponse.SC_SERVICE_UNAVAILABLE, "Component catalog is unavailable.");
        } catch (RuntimeException e) {
            LOG.error("Unable to build the component catalog", e);
            writeError(response, SlingHttpServletResponse.SC_INTERNAL_SERVER_ERROR, "Component catalog could not be generated.");
        }
    }

    @Override
    public void onChange(List<ResourceChange> changes) {
        cache = null;
    }

    private CatalogData getCatalog() throws LoginException {
        CacheEntry current = cache;
        long now = System.currentTimeMillis();
        if (current != null && now - current.createdAt <= CACHE_MILLIS) {
            return current.data;
        }
        synchronized (this) {
            current = cache;
            if (current != null && now - current.createdAt <= CACHE_MILLIS) {
                return current.data;
            }
            CatalogData built = buildCatalog();
            cache = new CacheEntry(now, built);
            return built;
        }
    }

    private CatalogData buildCatalog() throws LoginException {
        Map<String, Object> authentication = Collections.<String, Object>singletonMap(
                ResourceResolverFactory.SUBSERVICE,
                SUBSERVICE_NAME
        );
        try (ResourceResolver resolver = resolverFactory.getServiceResourceResolver(authentication)) {
            Resource root = resolver.getResource(COMPONENTS_ROOT);
            if (root == null) {
                throw new IllegalStateException("Configured component root does not exist");
            }
            List<Map<String, Object>> components = new ArrayList<>();
            Map<String, Integer> groups = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
            collectComponents(root, components, groups);
            components.sort((left, right) -> String.valueOf(left.get("title"))
                    .compareToIgnoreCase(String.valueOf(right.get("title"))));
            Map<String, Integer> categories = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
            int totalScore = 0;
            for (Map<String, Object> component : components) {
                totalScore += (Integer) component.get("qualityScore");
                categories.merge(String.valueOf(component.get("category")), 1, Integer::sum);
            }
            int average = components.isEmpty() ? 0 : Math.round((float) totalScore / components.size());
            return new CatalogData(components, groups, categories, average);
        }
    }

    private void collectComponents(
            Resource parent,
            List<Map<String, Object>> components,
            Map<String, Integer> groups
    ) {
        Iterator<Resource> children = parent.listChildren();
        while (children.hasNext()) {
            Resource resource = children.next();
            ValueMap properties = resource.getValueMap();
            if ("cq:Component".equals(properties.get("jcr:primaryType", String.class))) {
                addComponent(resource, properties, components, groups);
            }
            collectComponents(resource, components, groups);
        }
    }

    private void addComponent(
            Resource resource,
            ValueMap properties,
            List<Map<String, Object>> components,
            Map<String, Integer> groups
    ) {
        String group = properties.get("componentGroup", String.class);
        if (group == null || EXCLUDED_GROUPS.contains(group)) {
            return;
        }
        String resourceType = resource.getPath().replaceFirst("^/apps/", "");
        String owner = properties.get(OWNER_PROPERTY, "");
        String status = properties.get(STATUS_PROPERTY, "");
        String version = properties.get(VERSION_PROPERTY, "");
        boolean hasDialog = resource.getChild("_cq_dialog") != null || resource.getChild("cq:dialog") != null;
        boolean hasEditConfig = resource.getChild("_cq_editConfig") != null || resource.getChild("cq:editConfig") != null;
        boolean hasDesignDialog = resource.getChild("_cq_design_dialog") != null || resource.getChild("cq:design_dialog") != null;
        boolean hasReadme = resource.getChild("README.md") != null;
        String relativeName = resource.getPath().substring(COMPONENTS_ROOT.length() + 1);

        // Images are author-managed in the DAM (no deploy): /content/dam/<app>/catalog/<component>.
        // Fall back to any thumbnail/layouts shipped under /apps only when the DAM has none.
        Resource damFolder = resource.getResourceResolver().getResource(ASSET_ROOT + "/" + relativeName);
        String thumbnailPath = damThumbnail(damFolder);
        List<Map<String, String>> layouts = damImages(damFolder);
        if (thumbnailPath == null) {
            Resource appsThumbnail = findThumbnail(resource);
            if (appsThumbnail != null) thumbnailPath = appsThumbnail.getPath();
        }
        if (layouts.isEmpty()) {
            layouts = findLayouts(resource);
        }

        List<String> missing = new ArrayList<>();
        int score = qualityScore(hasDialog, hasReadme, thumbnailPath != null, owner, status, version, missing);

        int firstSlash = relativeName.indexOf('/');
        String categoryKey = firstSlash > 0 ? relativeName.substring(0, firstSlash) : "";
        String category = CATEGORY_LABELS.getOrDefault(categoryKey, prettifyCategory(categoryKey));
        String curatedSubCategory = properties.get(SUB_CATEGORY_PROPERTY, "");
        String subCategory = !curatedSubCategory.isEmpty() ? curatedSubCategory : group;

        Map<String, Object> component = new LinkedHashMap<>();
        component.put("name", relativeName);
        component.put("title", properties.get("jcr:title", resource.getName()));
        component.put("description", properties.get("jcr:description", ""));
        component.put("group", group);
        component.put("category", category);
        component.put("categoryKey", categoryKey);
        component.put("subCategory", subCategory);
        component.put("resourceType", resourceType);
        component.put("superType", properties.get("sling:resourceSuperType", ""));
        component.put("isContainer", properties.get("cq:isContainer", false));
        component.put("path", resource.getPath());
        component.put("hasDialog", hasDialog);
        component.put("hasEditConfig", hasEditConfig);
        component.put("hasDesignDialog", hasDesignDialog);
        component.put("dialogFields", readDialogFields(resource));
        component.put("owner", owner);
        component.put("status", status);
        component.put("version", version);
        component.put("tags", readTags(properties));
        component.put("qualityScore", score);
        component.put("qualityGrade", qualityGrade(score));
        component.put("qualityMissing", missing);
        if (hasReadme) component.put("readmePath", resource.getChild("README.md").getPath());
        if (thumbnailPath != null) component.put("thumbnailPath", thumbnailPath);
        if (!layouts.isEmpty()) component.put("layouts", layouts);
        components.add(component);
        groups.merge(group, 1, Integer::sum);
    }

    private Resource findThumbnail(Resource component) {
        for (String name : THUMBNAIL_NAMES) {
            Resource candidate = component.getChild(name);
            if (candidate != null) return candidate;
        }
        Resource layouts = component.getChild(LAYOUT_FOLDER);
        if (layouts != null) {
            for (Resource candidate : layouts.getChildren()) {
                if (isImage(candidate.getName()) && isExcludedLayout(candidate.getName())) return candidate;
            }
        }
        return null;
    }

    /** Card thumbnail from the component's DAM folder: a thumbnail.* asset, else the first image. */
    private String damThumbnail(Resource folder) {
        if (folder == null) return null;
        String firstImage = null;
        for (Resource child : folder.getChildren()) {
            String name = child.getName();
            if (!isImage(name)) continue;
            if (isThumbnailName(name)) return child.getPath();
            if (firstImage == null) firstImage = child.getPath();
        }
        return firstImage;
    }

    /** Detail-gallery images from the component's DAM folder (every image except thumbnail.*). */
    private List<Map<String, String>> damImages(Resource folder) {
        List<Map<String, String>> images = new ArrayList<>();
        if (folder == null) return images;
        for (Resource child : folder.getChildren()) {
            String name = child.getName();
            if (!isImage(name) || isThumbnailName(name)) continue;
            Map<String, String> image = new LinkedHashMap<>();
            image.put("name", name);
            image.put("path", child.getPath());
            images.add(image);
        }
        return images;
    }

    private boolean isThumbnailName(String fileName) {
        for (String name : THUMBNAIL_NAMES) {
            if (name.equalsIgnoreCase(fileName)) return true;
        }
        return false;
    }

    private List<Map<String, Object>> readDialogFields(Resource component) {
        Resource dialog = component.getChild("_cq_dialog");
        if (dialog == null) dialog = component.getChild("cq:dialog");
        if (dialog == null) return Collections.emptyList();
        List<Map<String, Object>> fields = new ArrayList<>();
        collectDialogFields(dialog, fields);
        return fields;
    }

    private void collectDialogFields(Resource parent, List<Map<String, Object>> fields) {
        ValueMap properties = parent.getValueMap();
        String name = properties.get("name", "");
        if (name.startsWith("./")) {
            Map<String, Object> field = new LinkedHashMap<>();
            field.put("name", name);
            field.put("label", properties.get("fieldLabel", properties.get("jcr:title", name.substring(2))));
            field.put("resourceType", properties.get("sling:resourceType", ""));
            field.put("required", properties.get("required", false));
            fields.add(field);
        }
        for (Resource child : parent.getChildren()) {
            collectDialogFields(child, fields);
        }
    }

    private List<Map<String, String>> findLayouts(Resource component) {
        Resource folder = component.getChild(LAYOUT_FOLDER);
        if (folder == null) return Collections.emptyList();
        List<Map<String, String>> layouts = new ArrayList<>();
        for (Resource resource : folder.getChildren()) {
            if (!isImage(resource.getName()) || isExcludedLayout(resource.getName())) continue;
            Map<String, String> layout = new LinkedHashMap<>();
            layout.put("name", resource.getName());
            layout.put("path", resource.getPath());
            layouts.add(layout);
        }
        return layouts;
    }

    private boolean isExcludedLayout(String fileName) {
        for (String glob : LAYOUT_EXCLUDES) {
            StringBuilder expression = new StringBuilder("^");
            for (char character : glob.toCharArray()) {
                expression.append(character == '*' ? ".*" : Pattern.quote(String.valueOf(character)));
            }
            if (fileName.matches(expression.append('$').toString())) return true;
        }
        return false;
    }

    private boolean isImage(String name) {
        return name.matches("(?i).+\\.(svg|png|jpe?g|webp)$");
    }

    private List<String> readTags(ValueMap properties) {
        String[] tags = properties.get(TAGS_PROPERTY, String[].class);
        if (tags != null) {
            List<String> result = new ArrayList<>();
            Collections.addAll(result, tags);
            return result;
        }
        String tag = properties.get(TAGS_PROPERTY, String.class);
        return tag == null || tag.isEmpty() ? Collections.<String>emptyList() : Collections.singletonList(tag);
    }

    private int qualityScore(
            boolean dialog,
            boolean readme,
            boolean thumbnail,
            String owner,
            String status,
            String version,
            List<String> missing
    ) {
        int score = 0;
        if (dialog) score += 25; else missing.add("author dialog");
        if (readme) score += 20; else missing.add("README documentation");
        if (thumbnail) score += 15; else missing.add("thumbnail");
        if (!owner.isEmpty()) score += 15; else missing.add("owner");
        if (!status.isEmpty()) score += 15; else missing.add("lifecycle status");
        if (!version.isEmpty()) score += 10; else missing.add("version");
        return score;
    }

    private String qualityGrade(int score) {
        if (score >= 90) return "A";
        if (score >= 80) return "B";
        if (score >= 70) return "C";
        if (score >= 60) return "D";
        return "F";
    }

    private String prettifyCategory(String key) {
        if (key == null || key.isEmpty()) {
            return "General";
        }
        return Character.toUpperCase(key.charAt(0)) + key.substring(1);
    }

    private int boundedInteger(String raw, int fallback, int minimum, int maximum) {
        if (raw == null) return fallback;
        try {
            return Math.max(minimum, Math.min(maximum, Integer.parseInt(raw)));
        } catch (NumberFormatException ignored) {
            return fallback;
        }
    }

    private void secureHeaders(SlingHttpServletResponse response) {
        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");
        response.setHeader("Cache-Control", "private, max-age={{cacheSeconds}}");
        response.setHeader("Vary", "Cookie");
        response.setHeader("X-Content-Type-Options", "nosniff");
    }

    private void writeError(SlingHttpServletResponse response, int status, String message) throws IOException {
        response.setStatus(status);
        response.getWriter().write(GSON.toJson(Collections.singletonMap("error", message)));
    }

    private static final class CacheEntry {
        private final long createdAt;
        private final CatalogData data;

        private CacheEntry(long createdAt, CatalogData data) {
            this.createdAt = createdAt;
            this.data = data;
        }
    }

    private static final class CatalogData {
        private final List<Map<String, Object>> components;
        private final Map<String, Integer> groups;
        private final Map<String, Integer> categories;
        private final int averageQualityScore;

        private CatalogData(
                List<Map<String, Object>> components,
                Map<String, Integer> groups,
                Map<String, Integer> categories,
                int averageQualityScore
        ) {
            this.components = components;
            this.groups = groups;
            this.categories = categories;
            this.averageQualityScore = averageQualityScore;
        }
    }
}

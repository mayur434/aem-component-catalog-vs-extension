package {{package}};

import java.io.IOException;
import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.TreeMap;

import javax.servlet.Servlet;

import org.apache.sling.api.SlingHttpServletRequest;
import org.apache.sling.api.SlingHttpServletResponse;
import org.apache.sling.api.resource.LoginException;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.api.resource.ResourceResolverFactory;
import org.apache.sling.api.resource.ValueMap;
import org.apache.sling.api.servlets.SlingSafeMethodsServlet;
import org.apache.sling.servlets.annotations.SlingServletResourceTypes;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Reference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.google.gson.Gson;
import com.google.gson.GsonBuilder;

/**
 * Component Library Servlet — auto-discovers all components under {{componentRoot}}
 * and returns JSON with metadata, groups, README paths, and layout image paths.
 *
 * Generated by AEM Component Library Generator.
 */
@Component(service = Servlet.class)
@SlingServletResourceTypes(
        resourceTypes = "{{resourceType}}",
        selectors = "components",
        extensions = "json",
        methods = "GET"
)
public class ComponentLibraryServlet extends SlingSafeMethodsServlet {

    private static final Logger LOG = LoggerFactory.getLogger(ComponentLibraryServlet.class);
    private static final String COMPONENTS_ROOT = "{{componentRoot}}";
    private static final String SUBSERVICE_NAME = "{{subServiceName}}";

    @Reference
    private ResourceResolverFactory resolverFactory;

    @Override
    protected void doGet(SlingHttpServletRequest request, SlingHttpServletResponse response)
            throws IOException {

        response.setContentType("application/json");
        response.setCharacterEncoding("UTF-8");

        ResourceResolver serviceResolver = null;
        try {
            Map<String, Object> authInfo = new LinkedHashMap<>();
            authInfo.put(ResourceResolverFactory.SUBSERVICE, SUBSERVICE_NAME);
            serviceResolver = resolverFactory.getServiceResourceResolver(authInfo);

            Resource componentsRoot = serviceResolver.getResource(COMPONENTS_ROOT);
            if (componentsRoot == null) {
                writeError(response, "Components root not found: " + COMPONENTS_ROOT);
                return;
            }

            List<Map<String, Object>> components = new ArrayList<>();
            Map<String, Integer> groupCounts = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);

            Iterator<Resource> children = componentsRoot.listChildren();
            while (children.hasNext()) {
                Resource compResource = children.next();
                ValueMap props = compResource.getValueMap();

                String primaryType = props.get("jcr:primaryType", String.class);
                if (!"cq:Component".equals(primaryType)) {
                    continue;
                }

                String componentGroup = props.get("componentGroup", String.class);
                if (componentGroup == null) {
                    continue;
                }

                // Skip excluded groups
                {{#each excludedGroups}}
                if ("{{this}}".equals(componentGroup)) {
                    continue;
                }
                {{/each}}

                String name = compResource.getName();
                String title = props.get("jcr:title", name);
                String description = props.get("jcr:description", "");
                String superType = props.get("sling:resourceSuperType", "");
                boolean isContainer = props.get("cq:isContainer", false);

                Map<String, Object> comp = new LinkedHashMap<>();
                comp.put("name", name);
                comp.put("title", title);
                comp.put("description", description);
                comp.put("group", componentGroup);
                comp.put("resourceType", "{{appId}}/components/" + name);
                comp.put("superType", superType);
                comp.put("isContainer", isContainer);
                comp.put("path", compResource.getPath());

                // Check for README.md
                Resource readme = compResource.getChild("README.md");
                if (readme != null) {
                    comp.put("readmePath", readme.getPath());
                }

                // Check for thumbnail image
                Resource thumbnail = null;
                {{#each thumbnailFileNames}}
                if (thumbnail == null) {
                    thumbnail = compResource.getChild("{{this}}");
                }
                {{/each}}
                if (thumbnail != null) {
                    comp.put("thumbnailPath", thumbnail.getPath());
                }

                // Check for layouts folder with images
                Resource layoutsFolder = compResource.getChild("{{layoutFolderName}}");
                if (layoutsFolder != null) {
                    List<Map<String, String>> layouts = new ArrayList<>();
                    Iterator<Resource> layoutChildren = layoutsFolder.listChildren();
                    while (layoutChildren.hasNext()) {
                        Resource layoutRes = layoutChildren.next();
                        String layoutName = layoutRes.getName();
                        if (layoutName.endsWith(".svg") || layoutName.endsWith(".png")
                                || layoutName.endsWith(".jpg") || layoutName.endsWith(".webp")) {
                            String baseName = layoutName.substring(0, layoutName.lastIndexOf('.'));
                            {{#each layoutExclude}}
                            // Skip excluded layout patterns (e.g. thumbnail.*)
                            if (baseName.matches("(?i){{replace this "*" ".*"}}") || baseName.equalsIgnoreCase("{{replace this ".*" ""}}")) {
                                if (!comp.containsKey("thumbnailPath")) {
                                    comp.put("thumbnailPath", layoutRes.getPath());
                                }
                                continue;
                            }
                            {{/each}}
                            Map<String, String> layout = new LinkedHashMap<>();
                            layout.put("name", layoutName);
                            layout.put("path", layoutRes.getPath());
                            layouts.add(layout);
                        }
                    }
                    if (!layouts.isEmpty()) {
                        comp.put("layouts", layouts);
                    }
                }

                // Check for dialog
                Resource dialog = compResource.getChild("_cq_dialog");
                if (dialog == null) {
                    dialog = compResource.getChild("cq:dialog");
                }
                comp.put("hasDialog", dialog != null);

                // Check for editConfig
                Resource editConfig = compResource.getChild("_cq_editConfig");
                if (editConfig == null) {
                    editConfig = compResource.getChild("cq:editConfig");
                }
                comp.put("hasEditConfig", editConfig != null);

                components.add(comp);
                groupCounts.merge(componentGroup, 1, Integer::sum);
            }

            Map<String, Object> result = new LinkedHashMap<>();
            result.put("total", components.size());
            result.put("groups", groupCounts);
            result.put("components", components);

            Gson gson = new GsonBuilder().disableHtmlEscaping().create();
            PrintWriter writer = response.getWriter();
            writer.write(gson.toJson(result));

        } catch (LoginException e) {
            LOG.error("Failed to obtain service resource resolver for {{subServiceName}}", e);
            writeError(response, "Service user authentication failed. Check repoinit configuration.");
        } finally {
            if (serviceResolver != null && serviceResolver.isLive()) {
                serviceResolver.close();
            }
        }
    }

    private void writeError(SlingHttpServletResponse response, String message) throws IOException {
        response.setStatus(SlingHttpServletResponse.SC_INTERNAL_SERVER_ERROR);
        response.getWriter().write("{\"error\":\"" + message.replace("\"", "'") + "\"}");
    }
}

<!--/*
    {{hero.titlePrefix}} — Component Catalog (body.html)
    Fully dynamic shell — JS fetches servlet JSON and renders listing or detail via suffix.
    Servlet endpoint: <pagePath>.components.json
    Detail route:     <pagePath>.html/<componentName>

    Generated by AEM Component Library Generator.
*/-->
<sly data-sly-set.pagePath="${currentPage.path}"/>

<div class="pcl-library" data-page-path="${pagePath}">

    <!--/* HERO — always visible */-->
    <section class="pcl-hero">
        <div class="pcl-hero__inner">
            <div class="pcl-hero__badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                {{xml hero.badge}}
            </div>
            <h1 class="pcl-hero__title">
                {{xml hero.titlePrefix}} <span>{{xml hero.titleHighlight}}</span>
            </h1>
            <p class="pcl-hero__desc">
                {{xml hero.description}}
            </p>
            <div class="pcl-hero__stats">
                <div class="pcl-hero__stat">
                    <span class="pcl-hero__stat-value" id="pcl-total-count">—</span>
                    <span class="pcl-hero__stat-label">Components</span>
                </div>
                <div class="pcl-hero__stat">
                    <span class="pcl-hero__stat-value" id="pcl-category-count">—</span>
                    <span class="pcl-hero__stat-label">Categories</span>
                </div>
                {{#each hero.stats}}
                <div class="pcl-hero__stat">
                    <span class="pcl-hero__stat-value">{{xml this.value}}</span>
                    <span class="pcl-hero__stat-label">{{xml this.label}}</span>
                </div>
                {{/each}}
            </div>
        </div>
    </section>

    <!--/* TOOLBAR — search + filter pills (generated by JS) */-->
    <div class="pcl-toolbar" id="pcl-toolbar" style="display:none;">
        <div class="pcl-toolbar__inner">
            <div class="pcl-search">
                <svg class="pcl-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="search" class="pcl-search__input" aria-label="Search components" placeholder="Search by name, group, owner, status, or description…" />
            </div>
            <div class="pcl-filter-pills" id="pcl-filter-pills"></div>
        </div>
    </div>

    <!--/* MAIN CONTENT — JS renders listing grid or detail view here */-->
    <div id="pcl-main" class="pcl-content">
        <div class="pcl-loading">
            <div class="pcl-loading__spinner"></div>
            <p>Discovering components…</p>
        </div>
    </div>

    {{#if features.lightbox}}
    <!--/* LIGHTBOX (reused by detail gallery) */-->
    <div class="pcl-lightbox" id="pcl-lightbox" role="dialog" aria-modal="true" aria-label="Layout preview" aria-hidden="true">
        <div class="pcl-lightbox__backdrop"></div>
        <div class="pcl-lightbox__content">
            <img src="" alt=""/>
            <button type="button" class="pcl-lightbox__close" aria-label="Close preview"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
            <button type="button" class="pcl-lightbox__nav pcl-lightbox__nav--prev" aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
            <button type="button" class="pcl-lightbox__nav pcl-lightbox__nav--next" aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg></button>
        </div>
        <p class="pcl-lightbox__caption"></p>
    </div>
    {{/if}}

    <!--/* FOOTER */-->
    <footer class="pcl-footer">
        {{xml hero.footerText}}
    </footer>
</div>

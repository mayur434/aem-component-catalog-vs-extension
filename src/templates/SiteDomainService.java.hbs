package {{package}};

import java.util.HashMap;
import java.util.Map;

import org.osgi.service.component.annotations.Activate;
import org.osgi.service.component.annotations.Component;
import org.osgi.service.component.annotations.Modified;
import org.osgi.service.metatype.annotations.AttributeDefinition;
import org.osgi.service.metatype.annotations.Designate;
import org.osgi.service.metatype.annotations.ObjectClassDefinition;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Maps a live content page's site root (the first path segment under /content) to
 * that site's public domain, so links built from raw JCR paths - such as the
 * component-usage links - can be turned into absolute URLs that resolve regardless
 * of which host the catalog itself is being viewed from.
 *
 * <p>Each brand site this catalog scans is served from its own public domain, so a
 * path-only link only ever worked by coincidence when the catalog was browsed from
 * the same AEM host that also happens to serve /content directly (author/publish IP,
 * localhost); it 404s once the catalog is opened from its own public domain, which
 * does not serve the other sites' /content trees.
 *
 * <p>Unconfigured roots resolve to {@code null}; callers fall back to their previous
 * relative-link behaviour, so leaving an entry blank cannot make things worse than
 * before this mapping existed.
 *
 * Generated by AEM Component Catalog.
 */
@Component(service = SiteDomainService.class)
@Designate(ocd = SiteDomainService.Config.class)
public final class SiteDomainService {

    @ObjectClassDefinition(name = {{javaString ocdName}},
            description = "Maps each brand site's /content root segment to its public domain, so "
                    + "component usage links resolve correctly no matter which host the catalog is "
                    + "viewed from. Place config in the appropriate run mode (config.stage / "
                    + "config.prod) since stage and prod domains usually differ.")
    @interface Config {
        @AttributeDefinition(name = "Site domains",
                description = "One entry per site, formatted <contentRootSegment>=<https://domain>, "
                        + "e.g. {{exampleEntry}}. The content root "
                        + "segment is the first path element under /content - note this is the site's "
                        + "actual JCR root name, which does not necessarily have to match the "
                        + "component library's own /apps category key. Leave the value empty "
                        + "(\"key=\") to keep the old relative-link behaviour for that site.")
        String[] siteDomains() default {
        {{#each siteDomainCategories}}
                {{javaString this.entry}}{{#unless @last}},{{/unless}}
        {{/each}}
        };
    }

    private static final Logger LOG = LoggerFactory.getLogger(SiteDomainService.class);

    private volatile Map<String, String> domainsByRoot = new HashMap<>();

    @Activate
    @Modified
    protected void activate(Config config) {
        Map<String, String> next = new HashMap<>();
        for (String entry : config.siteDomains()) {
            if (entry == null) {
                continue;
            }
            int eq = entry.indexOf('=');
            if (eq <= 0) {
                continue;
            }
            String root = entry.substring(0, eq).trim();
            String domain = entry.substring(eq + 1).trim();
            if (root.isEmpty() || domain.isEmpty()) {
                continue;
            }
            while (domain.endsWith("/")) {
                domain = domain.substring(0, domain.length() - 1);
            }
            next.put(root, domain);
        }
        domainsByRoot = next;
        LOG.info("Site domain mapping loaded: {} configured root(s) of {} entries",
                next.size(), config.siteDomains().length);
    }

    /**
     * Turns a raw JCR content path into a fully-qualified page URL using the domain
     * configured for that path's site root, or {@code null} if that root has no
     * domain configured (callers should fall back to their previous relative-link
     * behaviour).
     */
    public String resolveUrl(String contentPath) {
        if (contentPath == null || !contentPath.startsWith("/content/")) {
            return null;
        }
        String rest = contentPath.substring("/content/".length());
        int slash = rest.indexOf('/');
        String root = slash > 0 ? rest.substring(0, slash) : rest;
        String domain = domainsByRoot.get(root);
        if (domain == null || domain.isEmpty()) {
            return null;
        }
        return domain + contentPath + ".html";
    }
}

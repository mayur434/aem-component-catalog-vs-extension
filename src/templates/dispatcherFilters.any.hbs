# ------------------------------------------------------------------------------
# Component Catalog — dispatcher allow rules (publish tier)
#
# The AEMaaCS default filter set denies everything and then allows a narrow list. That
# list does NOT cover this micro-site, so without these rules the catalog page renders
# but its data endpoint is blocked and the listing comes back empty.
#
# THIS FILE IS NOT DEPLOYED BY THIS PROJECT. Cloud Manager only applies dispatcher
# configuration from the repository its own pipeline builds. Copy this file into the
# repository that owns the dispatcher config for the target program, placing it in
# src/conf.dispatcher.d/filters/, then include it from that farm's filter section AFTER
# the default filters so these allows are additive:
#
#     $include "./component-catalog-filters.any"
#
# NOTE ON ACCESS CONTROL: these rules make the catalog REACHABLE on publish. They are not
# an authentication mechanism. The catalog exposes internal component names, dialog
# fields, and every page path each component is used on, so it must sit behind the
# access control you have chosen for it (dedicated sub-domain + basic auth at the CDN /
# edge). Do not include these rules on a farm that serves your public sites.
#
# Generated by AEM Component Catalog.
# ------------------------------------------------------------------------------

# The catalog page itself.
/0500 {
  /type "allow"
  /method "GET"
  /path "{{contentPath}}"
  /extension "html"
}

# Component detail views. The micro-site routes to a component with a URL suffix
# (<page>.html/<component-name>), which the default filters would otherwise reject.
/0501 {
  /type "allow"
  /method "GET"
  /path "{{contentPath}}"
  /extension "html"
  /suffix "*"
}

# The catalog data endpoint (<page>/_jcr_content.components.json). The selector is
# pinned so this does not open up arbitrary .json traversal of the content tree.
/0502 {
  /type "allow"
  /method "GET"
  /path "{{contentPath}}/_jcr_content"
  /selectors "components"
  /extension "json"
}

# Client library (proxied via /etc.clientlibs because the clientlib sets allowProxy).
/0503 {
  /type "allow"
  /method "GET"
  /path "/etc.clientlibs/{{appId}}/clientlibs/*"
  /extension '(css|js|map|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif)'
}

# Author-managed component imagery (thumbnails and gallery shots) from the DAM.
/0504 {
  /type "allow"
  /method "GET"
  /path "{{assetRoot}}/*"
  /extension '(png|jpg|jpeg|gif|svg|webp)'
}

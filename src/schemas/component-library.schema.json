{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aem-catalog.example/schemas/aem-component-catalog-v2.json",
  "title": "AEMaaCS Enterprise Component Catalog Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/color" },
        "primaryLight": { "$ref": "#/$defs/color" },
        "primaryDark": { "$ref": "#/$defs/color" },
        "primaryDeeper": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentHover": { "$ref": "#/$defs/color" },
        "gold": { "$ref": "#/$defs/color" },
        "sky": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "font": { "type": "string", "maxLength": 120 },
        "fontFallback": { "type": "string", "maxLength": 240 }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "pattern": "^/apps/[a-zA-Z0-9._:/-]+$" },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exclude": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "thumbnails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fileNames": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "fallbackIcon": { "type": "string" }
          }
        },
        "layouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folderName": { "type": "string" },
            "exclude": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": { "type": "boolean" },
        "groupFilters": { "type": "boolean" },
        "lightbox": { "type": "boolean" },
        "codeSnippets": { "type": "boolean" },
        "readme": { "type": "boolean" },
        "darkMode": { "type": "boolean" },
        "qualityScore": { "type": "boolean" },
        "dependencyGraph": { "type": "boolean" },
        "accessibility": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servletPackage": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z][a-zA-Z0-9]*)+$" },
        "clientlibCategory": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "contentPath": { "type": "string", "pattern": "^/content/[a-zA-Z0-9._:/-]+$" },
        "pageTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "pageResourceType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" }
      }
    },
    "serviceUser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "subServiceName": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "bundleSymbolicName": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "badge": { "type": "string", "maxLength": 80 },
        "titlePrefix": { "type": "string", "maxLength": 120 },
        "titleHighlight": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "stats": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "maxLength": 80 },
              "value": { "type": "string", "maxLength": 80 }
            }
          }
        },
        "footerText": { "type": "string", "maxLength": 240 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploymentTarget": { "const": "author" },
        "cacheSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "pageSize": { "type": "integer", "minimum": 25, "maximum": 1000 }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyFile": { "type": "string" },
        "ownerProperty": { "$ref": "#/$defs/propertyName" },
        "statusProperty": { "$ref": "#/$defs/propertyName" },
        "versionProperty": { "$ref": "#/$defs/propertyName" },
        "tagsProperty": { "$ref": "#/$defs/propertyName" }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "propertyName": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9:_-]*$" }
  }
}

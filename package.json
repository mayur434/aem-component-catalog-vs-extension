{
  "name": "aem-component-library-generator",
  "displayName": "AEM Component Catalog",
  "description": "Configure, generate, and deploy a browsable component showcase for your AEM as a Cloud Service project.",
  "version": "2.0.0",
  "publisher": "pidilite",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "AEM",
    "Adobe Experience Manager",
    "Component Library",
    "Sling",
    "OSGi",
    "AEMaaCS",
    "Cloud Manager",
    "Component Governance"
  ],
  "activationEvents": [
    "workspaceContains:pom.xml",
    "workspaceContains:*/pom.xml",
    "onCommand:aemComponentLibrary.configure",
    "onCommand:aemComponentLibrary.deployLocal",
    "onCommand:aemComponentLibrary.generate",
    "onCommand:aemComponentLibrary.preview",
    "onCommand:aemComponentLibrary.scan",
    "onCommand:aemComponentLibrary.doctor",
    "onCommand:aemComponentLibrary.rollback",
    "onCommand:aemComponentLibrary.exportSupportBundle",
    "onCommand:aemComponentLibrary.audit",
    "onCommand:aemComponentLibrary.openDashboard",
    "onView:aemCL.actions",
    "onView:aemCL.projects",
    "onView:aemCL.components"
  ],
  "main": "./out/extension.js",
  "bin": {
    "aem-catalog": "./out/cli.js"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "aemComponentLibrary.policyFile"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aemComponentLibrary",
          "title": "AEM Component Catalog",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aemComponentLibrary": [
        {
          "id": "aemCL.actions",
          "name": "Actions"
        },
        {
          "id": "aemCL.projects",
          "name": "Projects"
        },
        {
          "id": "aemCL.components",
          "name": "Components"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aemCL.actions",
        "contents": "Generate an internal component-catalog micro-site.\n[Configure & Generate Micro-site](command:aemComponentLibrary.configure)\n[Generate (no prompts)](command:aemComponentLibrary.generate)\n[Deploy to Local AEM](command:aemComponentLibrary.deployLocal)\n[Preview Changes](command:aemComponentLibrary.preview)"
      }
    ],
    "commands": [
      {
        "command": "aemComponentLibrary.configure",
        "title": "AEM Component Catalog: Configure & Generate Micro-site",
        "icon": "$(rocket)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.deployLocal",
        "title": "AEM Component Catalog: Deploy to Local AEM (core, ui.apps, ui.config)",
        "icon": "$(cloud-upload)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.generate",
        "title": "AEM Component Catalog: Generate (Use Existing Config)",
        "icon": "$(play)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.preview",
        "title": "AEM Component Catalog: Preview Generation Plan",
        "icon": "$(eye)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.scan",
        "title": "AEM Component Catalog: Scan Components",
        "icon": "$(search)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.refreshSidebar",
        "title": "AEM Component Catalog: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "aemComponentLibrary.openDashboard",
        "title": "AEM Component Catalog: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "aemComponentLibrary.doctor",
        "title": "AEM Component Catalog: (Advanced) Run AEM Cloud Doctor",
        "icon": "$(shield)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.rollback",
        "title": "AEM Component Catalog: Roll Back Last Generation",
        "icon": "$(history)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.exportSupportBundle",
        "title": "AEM Component Catalog: (Advanced) Export Redacted Support Bundle",
        "icon": "$(export)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "aemComponentLibrary.audit",
        "title": "AEM Component Audit: Generate Tech Audit Report (AEMaaCS & AMS)",
        "icon": "$(checklist)",
        "enablement": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aemComponentLibrary.refreshSidebar",
          "when": "view =~ /^aemCL\\./",
          "group": "navigation"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.component-library.json",
        "url": "./src/schemas/component-library.schema.json"
      },
      {
        "fileMatch": "**/.aem-catalog-policy.json",
        "url": "./src/schemas/aem-catalog-policy.schema.json"
      }
    ],
    "configuration": {
      "title": "AEM Component Catalog",
      "properties": {
        "aemComponentLibrary.policyFile": {
          "type": "string",
          "default": ".aem-catalog-policy.json",
          "description": "Workspace-relative enterprise policy file used by AEM Cloud Doctor."
        },
        "aemComponentLibrary.showInformationFindings": {
          "type": "boolean",
          "default": true,
          "description": "Show informational findings in Cloud Doctor reports."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc -p ./ --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "npm run compile && node test/integration/run.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run check && npm run lint && npm test",
    "package:vsix": "vsce package",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.16.5",
    "@types/vscode": "^1.100.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "handlebars": "^4.7.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pidilite/aem-component-catalog-vs-extension.git"
  },
  "bugs": {
    "url": "https://github.com/pidilite/aem-component-catalog-vs-extension/issues"
  },
  "homepage": "https://github.com/pidilite/aem-component-catalog-vs-extension#readme"
}
